#!/bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

mkdir -p "$TMP/bin" "$TMP/home/.local/share/applications" "$TMP/system/share/applications"
cp "$ROOT"/tests/fixtures/home/.local/share/applications/*.desktop "$TMP/home/.local/share/applications/"
cp "$ROOT"/tests/fixtures/system/share/applications/*.desktop "$TMP/system/share/applications/"

cat >"$TMP/bin/pacman" <<'EOF'
#!/bin/bash
case "${1:-}" in
  -Ql)
    printf 'fixture-package %s\n' \
      "$XDG_DATA_DIRS/applications/fixture-package.desktop" \
      "$XDG_DATA_DIRS/applications/fixture-package-helper.desktop" \
      "$XDG_DATA_DIRS/applications/fixture-package-hidden.desktop"
    ;;
  -Qqm) printf '%s\n' fixture-package ;;
  -Qqe) printf '%s\n' fixture-package ;;
  -Qqdt) exit 1 ;;
  -Qtdq) printf '%s\n' fixture-orphan ;;
  -Qqo)
    [[ ${2:-} == *fixture-package*.desktop ]] && { echo fixture-package; exit 0; }
    exit 1
    ;;
  -Q)
    if [[ $# == 1 ]]; then echo 'fixture-package 1.2.3-1'
    elif [[ ${2:-} == fixture-package ]]; then echo 'fixture-package 1.2.3-1'
    else exit 1
    fi
    ;;
  *) exit 1 ;;
esac
EOF

cat >"$TMP/bin/omarchy" <<'EOF'
#!/bin/bash
if [[ ${1:-} == plugin && ${2:-} == list ]]; then
  echo '[{"id":"omarchy.fixture","name":"System Fixture","kinds":["panel"],"enabled":true,"firstParty":true},{"id":"fixture.community","name":"Community Fixture","kinds":["panel"],"enabled":true,"firstParty":false}]'
elif [[ ${1:-} == version && ${2:-} == channel ]]; then echo stable
elif [[ ${1:-} == version && ${2:-} == pkgs ]]; then echo today
elif [[ ${1:-} == version ]]; then echo 4.0.0-test
elif [[ ${1:-} == theme && ${2:-} == current ]]; then echo 'Fixture Night'
elif [[ ${1:-} == theme && ${2:-} == bg && ${3:-} == current ]]; then echo 'Fixture Hills'
elif [[ ${1:-} == font && ${2:-} == current ]]; then [[ ${FIXTURE_FONT_FAIL:-false} != true ]] && echo 'Fixture Mono'
elif [[ ${1:-} == font && ${2:-} == list ]]; then [[ ${FIXTURE_FONT_FAIL:-false} != true ]] && printf '%s\n' 'Fixture Mono' 'Second Mono'
elif [[ ${1:-} == font && ${2:-} == set ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == display && ${2:-} == text && ${3:-} == size && $# == 3 ]]; then
  printf '%s\n' 'text size: 12 px' 'gtk text-scaling-factor: 1.0' 'terminal font: 9 pt'
elif [[ ${1:-} == display && ${2:-} == text && ${3:-} == size ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == bar && ${2:-} =~ ^(position|transparent)$ ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == toggle && ${2:-} == bar && ${3:-} == toggle ]]; then
  flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/bar-off"
  mkdir -p "$(dirname "$flag")"
  if [[ -e $flag ]]; then rm -f "$flag"; else touch "$flag"; fi
  printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == monitor && ${2:-} == state ]]; then
  printf '%s\n' 42 eDP-1 HDMI-A-1 eDP-1 '' eDP-1 1.25 '[{"name":"eDP-1","enabled":true,"focused":true,"width":1920,"height":1080},{"name":"HDMI-A-1","enabled":false,"focused":false,"width":2560,"height":1440}]'
elif [[ ${1:-} == hw && ${2:-} == touchpad ]]; then
  [[ ${FIXTURE_TOUCHPAD_MISSING:-false} != true ]] && echo 'fixture-touchpad'
elif [[ ${1:-} == toggle && ${2:-} == touchpad ]]; then
  flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/touchpad-disabled.lua"
  mkdir -p "$(dirname "$flag")"
  if [[ ${FIXTURE_TOUCHPAD_APPLY_FAIL:-false} != true ]]; then
    case "${3:-toggle}" in
      on) rm -f "$flag" ;;
      off) touch "$flag" ;;
      toggle) if [[ -e $flag ]]; then rm -f "$flag"; else touch "$flag"; fi ;;
    esac
  fi
  printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == network && ${2:-} == status ]]; then
  [[ ${FIXTURE_NETWORK_FAIL:-false} != true ]] || exit 1
  if [[ ${3:-} == --verbose ]]; then
    printf '%s\n' $'iface\twlan0' $'ip\t192.0.2.24' $'prefix\t24' $'type\twifi' $'ssid\tFixture Wi-Fi'
  else
    printf '%s\n' $'wifi\tFixture Wi-Fi\t73\t5180'
  fi
elif [[ ${1:-} == launch && ${2:-} == config && ${3:-} == editor ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == file && ${2:-} == select && ${3:-} == --directory ]]; then printf '%s\n' "$FIXTURE_SCAN_PICKER"
elif [[ ${1:-} == menu || ${1:-} == shell ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
else exit 0
fi
EOF

cat >"$TMP/bin/flatpak" <<'EOF'
#!/bin/bash
[[ ${1:-} == list ]] && exit 0
exit 1
EOF

cat >"$TMP/bin/hyprctl" <<'EOF'
#!/bin/bash
if [[ ${1:-} == binds ]]; then
  echo '[]'
elif [[ ${1:-} == monitors && ${2:-} == all && ${3:-} == -j ]]; then
  [[ ${FIXTURE_DISPLAY_FAIL:-false} != true ]] || exit 1
  cat <<'JSON'
[{"id":0,"name":"eDP-1","description":"Fixture Internal SERIAL-PRIVATE","make":"Fixture","model":"Panel 14","serial":"SERIAL-PRIVATE","width":1920,"height":1080,"refreshRate":59.951,"x":0,"y":0,"scale":1.25,"transform":0,"focused":true,"disabled":false},{"id":1,"name":"HDMI-A-1","description":"Fixture External OTHER-SERIAL","make":"Fixture","model":"Desk 27","serial":"OTHER-SERIAL","width":2560,"height":1440,"refreshRate":144.006,"x":1920,"y":0,"scale":1,"transform":0,"focused":false,"disabled":true}]
JSON
elif [[ ${1:-} == devices && ${2:-} == -j ]]; then
  [[ ${FIXTURE_INPUT_FAIL:-false} != true ]] || exit 1
  cat <<'JSON'
{"mice":[{"address":"0xprivate","name":"fixture-mouse","defaultSpeed":0.25,"scrollFactor":1.5},{"address":"0xprivate2","name":"fixture-touchpad","defaultSpeed":0,"scrollFactor":1}],"keyboards":[{"address":"0xprivate3","name":"fixture-keyboard","main":true,"active_keymap":"English (US)"}],"tablets":[{"address":"0xprivate4","name":"fixture-tablet"}],"touch":[{"address":"0xprivate5","name":"fixture-touchscreen"}],"switches":[]}
JSON
elif [[ ${1:-} == configerrors && -n ${FIXTURE_HYPR_ERRORS:-} ]]; then
  printf '%s\n' "$FIXTURE_HYPR_ERRORS"
else
  exit 0
fi
EOF

cat >"$TMP/bin/systemctl" <<'EOF'
#!/bin/bash
[[ -z ${FIXTURE_SYSTEMCTL_SLEEP:-} ]] || sleep "$FIXTURE_SYSTEMCTL_SLEEP"
if [[ -n ${FIXTURE_SYSTEMCTL_FAILURE:-} ]]; then
  printf '%s\n' "$FIXTURE_SYSTEMCTL_FAILURE"
fi
exit 0
EOF

cat >"$TMP/bin/mise" <<'EOF'
#!/bin/bash
if [[ ${FIXTURE_MISE_FAIL:-false} == true ]]; then exit 1; fi
if [[ ${1:-} == ls && ${2:-} == --installed && ${3:-} == --json ]]; then
  cat <<'JSON'
{"node":[{"version":"22.1.0","installed":true,"active":true,"install_path":"/private/node","source":{"path":"/private/mise.toml"}},{"version":"20.0.0","installed":true,"active":false}],"python":[{"version":"3.13.0","installed":false,"active":true}]}
JSON
else
  exit 1
fi
EOF

for name in omarchy-shell xdg-terminal-exec; do
  cat >"$TMP/bin/$name" <<'EOF'
#!/bin/bash
exit 0
EOF
done

cat >"$TMP/bin/lsblk" <<'EOF'
#!/bin/bash
cat <<'JSON'
{"blockdevices":[{"name":"nvme0n1","path":"/dev/nvme0n1","type":"disk","size":1000000000000,"fstype":null,"mountpoints":null,"label":null,"model":"Fixture NVMe","vendor":"Fixture","tran":"nvme","rota":false,"rm":false,"ro":false,"serial":"PRIVATE-SERIAL","children":[{"name":"nvme0n1p1","path":"/dev/nvme0n1p1","type":"part","size":999000000000,"fstype":"crypto_LUKS","mountpoints":null,"label":null,"ro":false,"children":[{"name":"fixture-root","path":"/dev/mapper/fixture-root","type":"crypt","size":998000000000,"fstype":"btrfs","mountpoints":["/home","/"],"label":null,"ro":false}]}]},{"name":"sda","path":"/dev/sda","type":"disk","size":500000000000,"fstype":null,"mountpoints":null,"label":null,"model":"Fixture SATA","vendor":"Fixture","tran":"sata","rota":false,"rm":false,"ro":false,"children":[]},{"name":"zram0","path":"/dev/zram0","type":"disk","size":8000000000,"fstype":"swap","mountpoints":["[SWAP]"],"label":null,"model":null,"vendor":null,"tran":null,"rota":false,"rm":false,"ro":false}]}
JSON
EOF

cat >"$TMP/bin/findmnt" <<'EOF'
#!/bin/bash
cat <<'JSON'
{"filesystems":[{"target":"/","source":"/dev/mapper/fixture-root[/@]","fstype":"btrfs","size":998000000000,"used":300000000000,"avail":698000000000,"use%":"31%","options":"rw,subvol=/@","children":[{"target":"/home","source":"/dev/mapper/fixture-root[/@home]","fstype":"btrfs","size":998000000000,"used":300000000000,"avail":698000000000,"use%":"31%","options":"rw,subvol=/@home"},{"target":"/boot","source":"/dev/nvme0n1p2","fstype":"vfat","size":1000000000,"used":250000000,"avail":750000000,"use%":"25%","options":"rw"}]}]}
JSON
EOF

cat >"$TMP/bin/busctl" <<'EOF'
#!/bin/bash
object="${4:-}"
property="${6:-}"
if [[ $object == */block_devices/nvme0n1 && $property == Drive ]]; then
  printf '%s\n' '{"type":"o","data":"/org/freedesktop/UDisks2/drives/fixture_nvme"}'
elif [[ $object == */drives/fixture_nvme ]]; then
  case "$property" in
    SmartCriticalWarning) printf '%s\n' '{"type":"as","data":[]}' ;;
    SmartTemperature) printf '%s\n' '{"type":"q","data":303}' ;;
    SmartPowerOnHours) printf '%s\n' '{"type":"t","data":1234}' ;;
    SmartSelftestStatus) printf '%s\n' '{"type":"s","data":"success"}' ;;
    SmartUpdated) printf '%s\n' '{"type":"t","data":1700000000}' ;;
    *) exit 1 ;;
  esac
else
  exit 1
fi
EOF

cat >"$TMP/bin/paccache" <<'EOF'
#!/bin/bash
printf '%s\n' "$OMAPANEL_PACMAN_CACHE/fixture-old.pkg.tar.zst"
EOF

cat >"$TMP/bin/journalctl" <<'EOF'
#!/bin/bash
if [[ ${1:-} == --disk-usage ]]; then
  echo 'Archived and active journals take up 64.0M in the file system.'
fi
EOF

cat >"$TMP/bin/snapper" <<'EOF'
#!/bin/bash
if [[ $* == *list-configs* ]]; then
  echo '{"configs":[{"config":"root","subvolume":"/"}]}'
elif [[ ${FIXTURE_SNAPPER_READABLE:-false} == true ]]; then
  echo '{"snapshots":[{"number":7,"type":"single","date":"2026-08-24 12:00:00","user":"root","description":"Fixture snapshot","cleanup":"number"}]}'
else
  echo 'No permissions.' >&2
  exit 1
fi
EOF

cat >"$TMP/bin/gio" <<'EOF'
#!/bin/bash
printf 'gio %s\n' "$*" >>"$FIXTURE_ACTION_LOG"
EOF

cat >"$TMP/bin/du" <<'EOF'
#!/bin/bash
if [[ ${FIXTURE_DU_SLOW:-false} == true ]]; then exec sleep 30; fi
exec /usr/bin/du "$@"
EOF

cat >"$TMP/bin/omarchy-shell" <<'EOF'
#!/bin/bash
[[ ${FIXTURE_SHELL_FAIL:-false} != true ]]
EOF

cat >"$TMP/bin/omarchy-theme-switcher" <<'EOF'
#!/bin/bash
printf '%s\n' 'Fixture Dawn'
printf '%s\n' 'theme picker' >>"$FIXTURE_ACTION_LOG"
EOF

cat >"$TMP/bin/omarchy-theme-set" <<'EOF'
#!/bin/bash
printf 'theme set %s\n' "$1" >>"$FIXTURE_ACTION_LOG"
EOF

cat >"$TMP/bin/omarchy-theme-bg-switcher" <<'EOF'
#!/bin/bash
printf '%s\n' '/tmp/fixture-background.jpg'
printf '%s\n' 'background picker' >>"$FIXTURE_ACTION_LOG"
EOF

cat >"$TMP/bin/omarchy-theme-bg-set" <<'EOF'
#!/bin/bash
printf 'background set %s\n' "$1" >>"$FIXTURE_ACTION_LOG"
EOF

cat >"$TMP/bin/wl-copy" <<'EOF'
#!/bin/bash
if [[ -n ${FIXTURE_CLIPBOARD:-} ]]; then
  tee "$FIXTURE_CLIPBOARD" >/dev/null
else
  cat >/dev/null
fi
EOF
chmod +x "$TMP/bin"/*

export PATH="$TMP/bin:/usr/bin:/bin"
export HOME="$TMP/home"
export XDG_CONFIG_HOME="$TMP/home/.config"
export XDG_DATA_HOME="$TMP/home/.local/share"
export XDG_DATA_DIRS="$TMP/system/share"
export XDG_STATE_HOME="$TMP/home/.local/state"
export FIXTURE_ACTION_LOG="$TMP/appearance-actions"
export OMAPANEL_PACMAN_CACHE="$TMP/pacman-cache"
export XDG_CACHE_HOME="$TMP/home/.cache"
export FIXTURE_SCAN_PICKER="$TMP/scan-root"

mkdir -p "$HOME/.config/omarchy" "$HOME/.config/hypr" "$XDG_STATE_HOME/omarchy/current/theme/backgrounds" \
  "$OMAPANEL_PACMAN_CACHE" "$XDG_CACHE_HOME" "$FIXTURE_SCAN_PICKER/folder one" "$FIXTURE_SCAN_PICKER/small"
dd if=/dev/zero of="$OMAPANEL_PACMAN_CACHE/fixture-current.pkg.tar.zst" bs=1024 count=3 status=none
dd if=/dev/zero of="$OMAPANEL_PACMAN_CACHE/fixture-old.pkg.tar.zst" bs=1024 count=2 status=none
dd if=/dev/zero of="$XDG_CACHE_HOME/fixture-cache" bs=1024 count=4 status=none
dd if=/dev/zero of="$FIXTURE_SCAN_PICKER/folder one/payload" bs=1024 count=8 status=none
dd if=/dev/zero of="$FIXTURE_SCAN_PICKER/direct-file" bs=1024 count=1 status=none
cat >"$HOME/.config/omarchy/shell.json" <<'EOF'
{"version":1,"bar":{"position":"bottom","transparent":true,"layout":{"left":[],"center":[],"right":[]}},"plugins":[]}
EOF
touch "$HOME/.config/hypr/monitors.lua" "$HOME/.config/hypr/input.lua"
touch "$XDG_STATE_HOME/omarchy/current/theme/backgrounds/0-fixture-hills.jpg"
ln -s "$XDG_STATE_HOME/omarchy/current/theme/backgrounds/0-fixture-hills.jpg" "$XDG_STATE_HOME/omarchy/current/background"

programs="$("$ROOT/scripts/omapanel-backend" collect programs)"
jq -e '.schemaVersion == 1 and (.programs | length) == 10' <<<"$programs" >/dev/null || fail "unexpected program count"
jq -e '.programs[] | select(.id == "desktop:fixture-web" and .kind == "webapp" and .actionAdapter == "webapp")' <<<"$programs" >/dev/null || fail "web app classification"
jq -e '.programs[] | select(.id == "desktop:fixture-tui" and .kind == "tui")' <<<"$programs" >/dev/null || fail "TUI classification"
jq -e '.programs[] | select(.id == "desktop:fixture-package" and .sourceId == "fixture-package")' <<<"$programs" >/dev/null || fail "package ownership"
jq -e '.programs[] | select(.id == "plugin:fixture.community" and .removable == true)' <<<"$programs" >/dev/null || fail "community plugin"
jq -e '.programs[] | select(.id == "plugin:omarchy.fixture" and .protected == true)' <<<"$programs" >/dev/null || fail "protected plugin"
jq -e '.programs[] | select(.id == "mise:node@22.1.0" and .kind == "mise" and .active == true and .removable == false and .actionAdapter == "")' <<<"$programs" >/dev/null || fail "Mise visibility-only tool"
jq -e '.programs[] | select(.id == "package:fixture-package" and .impactLauncherCount == 3 and (.impactLauncherNames | index("Fixture Package Hidden Helper")) and (.impactLauncherNamesText | contains("Fixture Package Hidden Helper")))' <<<"$programs" >/dev/null || fail "package launcher impact"
jq -e '.providers.mise == "ok" and (.errors | length) == 0' <<<"$programs" >/dev/null || fail "Mise provider status"

programs_without_mise="$(FIXTURE_MISE_FAIL=true "$ROOT/scripts/omapanel-backend" collect programs)"
jq -e '.providers.mise == "error" and (.errors[] | select(.provider == "mise")) and ([.programs[] | select(.kind == "mise")] | length == 0) and ([.programs[] | select(.kind == "app")] | length > 0)' <<<"$programs_without_mise" >/dev/null || fail "Mise provider failure isolation"

appearance="$("$ROOT/scripts/omapanel-backend" collect appearance)"
jq -e '.schemaVersion == 1 and .theme.current == "Fixture Night" and .background.current == "Fixture Hills" and (.background.path | endswith("0-fixture-hills.jpg"))' <<<"$appearance" >/dev/null || fail "appearance style state"
jq -e '.font.current == "Fixture Mono" and .font.installed == ["Fixture Mono","Second Mono"] and .textSize.currentPx == 12' <<<"$appearance" >/dev/null || fail "appearance typography state"
jq -e '.bar == {state:"ok",visible:true,position:"bottom",transparent:true}' <<<"$appearance" >/dev/null || fail "appearance bar state"
jq -e '.display.state == "ok" and .display.focusedMonitor == "eDP-1" and .display.scale == "1.25" and .display.brightnessPercent == 42 and .display.count == 2 and .display.enabledCount == 1 and .display.focusedWidth == 1920' <<<"$appearance" >/dev/null || fail "appearance display state"

appearance_without_fonts="$(FIXTURE_FONT_FAIL=true "$ROOT/scripts/omapanel-backend" collect appearance)"
jq -e '.font.state == "unavailable" and (.errors[] | select(.provider == "font")) and .theme.state == "ok" and .display.state == "ok"' <<<"$appearance_without_fonts" >/dev/null || fail "appearance provider failure isolation"

font_result="$("$ROOT/scripts/omapanel-backend" appearance set font 'Second Mono')"
jq -e '.ok and .setting == "font" and .value == "Second Mono"' <<<"$font_result" >/dev/null || fail "font setting result"
grep -Fx 'font set Second Mono' "$FIXTURE_ACTION_LOG" >/dev/null || fail "font setting handoff"
if "$ROOT/scripts/omapanel-backend" appearance set font 'Missing Mono' >/dev/null 2>&1; then fail "unknown font accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance set text-size 13 >/dev/null 2>&1; then fail "unsupported text size accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance set bar-position diagonal >/dev/null 2>&1; then fail "unsupported bar position accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance handoff '../unsafe' >/dev/null 2>&1; then fail "unknown appearance handoff accepted"; fi
"$ROOT/scripts/omapanel-backend" appearance set text-size 14 >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-position left >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-transparency false >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-visible false >/dev/null
[[ -e $XDG_STATE_HOME/omarchy/toggles/bar-off ]] || fail "bar was not hidden"
"$ROOT/scripts/omapanel-backend" appearance set bar-visible false >/dev/null
[[ $(grep -c '^toggle bar toggle$' "$FIXTURE_ACTION_LOG") == 1 ]] || fail "bar desired state toggled twice"
"$ROOT/scripts/omapanel-backend" appearance set bar-visible true >/dev/null
[[ ! -e $XDG_STATE_HOME/omarchy/toggles/bar-off ]] || fail "bar was not shown"
"$ROOT/scripts/omapanel-backend" appearance handoff theme
"$ROOT/scripts/omapanel-backend" appearance handoff background
"$ROOT/scripts/omapanel-backend" appearance handoff unlock
"$ROOT/scripts/omapanel-backend" appearance handoff font-install
"$ROOT/scripts/omapanel-backend" appearance handoff display
grep -Fx 'theme picker' "$FIXTURE_ACTION_LOG" >/dev/null || fail "theme picker handoff"
grep -Fx 'theme set Fixture Dawn' "$FIXTURE_ACTION_LOG" >/dev/null || fail "theme setter handoff"
grep -Fx 'background picker' "$FIXTURE_ACTION_LOG" >/dev/null || fail "background picker handoff"
grep -Fx 'background set /tmp/fixture-background.jpg' "$FIXTURE_ACTION_LOG" >/dev/null || fail "background setter handoff"
grep -Fx 'menu summon style.unlock' "$FIXTURE_ACTION_LOG" >/dev/null || fail "unlock picker handoff"
grep -Fx 'menu summon install.style.font' "$FIXTURE_ACTION_LOG" >/dev/null || fail "font install handoff"
grep -Fx 'shell omarchy.monitor show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "display panel handoff"

devices="$("$ROOT/scripts/omapanel-backend" collect devices)"
jq -e '.schemaVersion == 1 and .display.state == "ok" and .display.focusedMonitor == "eDP-1" and .display.brightnessPercent == 42 and (.display.displays | length) == 2' <<<"$devices" >/dev/null || fail "device display state"
jq -e '.display.displays[0] | .label == "Panel 14" and .refreshHz == 59.95 and .scale == 1.25 and .x == 0 and .enabled == true' <<<"$devices" >/dev/null || fail "device display normalization"
jq -e '.input.state == "ok" and .input.mainKeyboard.keymap == "English (US)" and .input.touchpad == {present:true,name:"fixture-touchpad",enabled:true} and (.input.pointers | length) == 2' <<<"$devices" >/dev/null || fail "device input state"
jq -e '.network == {state:"ok",type:"wifi",interface:"wlan0",ssid:"Fixture Wi-Fi",signal:73,ip:"192.0.2.24",prefix:"24"}' <<<"$devices" >/dev/null || fail "device network state"
[[ $devices != *SERIAL-PRIVATE* && $devices != *0xprivate* ]] || fail "device response leaked hardware identifiers"

devices_without_display="$(FIXTURE_DISPLAY_FAIL=true "$ROOT/scripts/omapanel-backend" collect devices)"
jq -e '.display.state == "unavailable" and (.errors[] | select(.provider == "display")) and .input.state == "ok" and .network.state == "ok"' <<<"$devices_without_display" >/dev/null || fail "device display failure isolation"
devices_without_input="$(FIXTURE_INPUT_FAIL=true "$ROOT/scripts/omapanel-backend" collect devices)"
jq -e '.input.state == "unavailable" and (.errors[] | select(.provider == "input")) and .display.state == "ok"' <<<"$devices_without_input" >/dev/null || fail "device input failure isolation"
devices_without_network="$(FIXTURE_NETWORK_FAIL=true "$ROOT/scripts/omapanel-backend" collect devices)"
jq -e '.network.state == "unavailable" and (.errors[] | select(.provider == "network")) and .display.state == "ok"' <<<"$devices_without_network" >/dev/null || fail "device network failure isolation"

touchpad_result="$("$ROOT/scripts/omapanel-backend" devices set touchpad false)"
jq -e '.ok and .setting == "touchpad" and .value == false and .previous == true' <<<"$touchpad_result" >/dev/null || fail "touchpad setting result"
[[ -e $XDG_STATE_HOME/omarchy/toggles/hypr/touchpad-disabled.lua ]] || fail "touchpad was not disabled"
"$ROOT/scripts/omapanel-backend" devices set touchpad false >/dev/null
[[ $(grep -c '^toggle touchpad off$' "$FIXTURE_ACTION_LOG") == 1 ]] || fail "touchpad desired state toggled twice"
"$ROOT/scripts/omapanel-backend" devices set touchpad true >/dev/null
[[ ! -e $XDG_STATE_HOME/omarchy/toggles/hypr/touchpad-disabled.lua ]] || fail "touchpad was not enabled"
if FIXTURE_TOUCHPAD_APPLY_FAIL=true "$ROOT/scripts/omapanel-backend" devices set touchpad false >/dev/null 2>&1; then fail "unverified touchpad change accepted"; fi
if "$ROOT/scripts/omapanel-backend" devices set touchpad maybe >/dev/null 2>&1; then fail "invalid touchpad value accepted"; fi
if "$ROOT/scripts/omapanel-backend" devices handoff '../unsafe' >/dev/null 2>&1; then fail "unknown device handoff accepted"; fi

for handoff in display audio bluetooth network monitor-config input-config; do
  "$ROOT/scripts/omapanel-backend" devices handoff "$handoff"
done
grep -Fx 'shell omarchy.monitor show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "device display handoff"
grep -Fx 'shell omarchy.audio show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "device audio handoff"
grep -Fx 'shell omarchy.bluetooth show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "device Bluetooth handoff"
grep -Fx 'shell omarchy.network show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "device network handoff"
grep -Fx "launch config editor $HOME/.config/hypr/monitors.lua" "$FIXTURE_ACTION_LOG" >/dev/null || fail "monitor config handoff"
grep -Fx "launch config editor $HOME/.config/hypr/input.lua" "$FIXTURE_ACTION_LOG" >/dev/null || fail "input config handoff"

storage="$("$ROOT/scripts/omapanel-backend" collect storage)"
jq -e '.schemaVersion == 1 and (.drives | length) == 2 and .drives[0].model == "Fixture NVMe" and .drives[0].encrypted == true and .drives[0].health.state == "healthy" and .drives[0].health.temperatureC == 29.9' <<<"$storage" >/dev/null || fail "storage drive and health state"
jq -e '(.filesystems | length) == 2 and .filesystems[0].mountpoint == "/" and .filesystems[0].mountpoints == ["/","/home"] and .filesystems[0].percent == 31' <<<"$storage" >/dev/null || fail "storage Btrfs filesystem deduplication"
jq -e '.maintenance.packageCache.totalBytes == 5120 and .maintenance.packageCache.fileCount == 2 and .maintenance.packageCache.prune.candidateBytes == 2048 and .maintenance.orphans.packages == ["fixture-orphan"] and .maintenance.journal.totalBytes > 0 and .maintenance.userCache.totalBytes > 0' <<<"$storage" >/dev/null || fail "storage maintenance insight"
jq -e '.snapshots.scopes[0].state == "permission-denied" and .snapshots.snapshotCount == 0' <<<"$storage" >/dev/null || fail "storage snapshot permission boundary"
[[ $storage != *PRIVATE-SERIAL* ]] || fail "storage response leaked hardware identifiers"

readable_storage="$(FIXTURE_SNAPPER_READABLE=true "$ROOT/scripts/omapanel-backend" collect storage)"
jq -e '.snapshots.scopes[0].state == "ok" and .snapshots.snapshotCount == 1 and .snapshots.scopes[0].snapshots[0].description == "Fixture snapshot"' <<<"$readable_storage" >/dev/null || fail "storage readable snapshots"

scan_output="$("$ROOT/scripts/omapanel-backend" storage scan "$FIXTURE_SCAN_PICKER")"
jq -s -e '.[0].event == "started" and .[-1].event == "completed" and .[-1].totalBytes > 0 and .[-1].directFileBytes > 0 and ([.[] | select(.event == "entry" and .name == "folder one" and .sizeBytes > 0)] | length) == 1' <<<"$scan_output" >/dev/null || fail "progressive storage scan"
set +e
invalid_scan="$("$ROOT/scripts/omapanel-backend" storage scan relative/path 2>/dev/null)"
invalid_scan_rc=$?
set -e
[[ $invalid_scan_rc == 2 ]] || fail "relative storage scan accepted"
jq -e '.event == "error" and (.message | contains("not readable"))' <<<"$invalid_scan" >/dev/null || fail "storage scan error event"

picker_output="$("$ROOT/scripts/omapanel-backend" storage choose-directory)"
jq -e --arg path "$FIXTURE_SCAN_PICKER" '.ok and (.cancelled | not) and .path == $path' <<<"$picker_output" >/dev/null || fail "storage folder picker"
"$ROOT/scripts/omapanel-backend" storage open "$FIXTURE_SCAN_PICKER"
grep -Fx "gio open $FIXTURE_SCAN_PICKER" "$FIXTURE_ACTION_LOG" >/dev/null || fail "storage file-manager handoff"

cancel_output="$TMP/storage-cancel.jsonl"
set +e
FIXTURE_DU_SLOW=true "$ROOT/scripts/omapanel-backend" storage scan "$FIXTURE_SCAN_PICKER" >"$cancel_output" &
cancel_pid=$!
for _ in {1..50}; do [[ -s $cancel_output ]] && break; sleep 0.01; done
kill -TERM "$cancel_pid"
wait "$cancel_pid"
cancel_rc=$?
set -e
[[ $cancel_rc == 130 ]] || fail "storage scan cancellation exit code"
jq -s -e '.[0].event == "started" and .[-1].event == "cancelled"' "$cancel_output" >/dev/null || fail "storage scan cancellation event"

cache_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run cache-prune _)"
jq -e '.ok and .terminal and .destructive and (.argv | join(" ") | contains("omarchy update pkg prune"))' <<<"$cache_preview" >/dev/null || fail "cache prune preview"
speed_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run disk-speedtest _)"
jq -e '.ok and (.destructive | not) and (.workflow | contains("temporary benchmark file")) and (.argv | join(" ") | contains("omarchy.disk-speedtest"))' <<<"$speed_preview" >/dev/null || fail "disk speed-test preview"
if "$ROOT/scripts/omapanel-backend" action --dry-run cache-prune unsafe >/dev/null 2>&1; then fail "storage action target accepted"; fi

doctor="$("$ROOT/scripts/omapanel-backend" collect doctor)"
jq -e '.schemaVersion == 2 and (.checks | length) == 11 and .overall.counts.total == 11' <<<"$doctor" >/dev/null || fail "Doctor schema"
jq -e '.checks[] | select(.id == "hyprland" and .status == "ok")' <<<"$doctor" >/dev/null || fail "Doctor healthy check"

timed_doctor="$(FIXTURE_SYSTEMCTL_SLEEP=0.2 OMAPANEL_CHECK_TIMEOUT=0.05 "$ROOT/scripts/omapanel-backend" collect doctor)"
jq -e '[.checks[] | select((.id == "user-services" or .id == "system-services") and .status == "unknown" and .failureReason == "timeout")] | length == 2' <<<"$timed_doctor" >/dev/null || fail "Doctor timeout isolation"
jq -e '.checks[] | select(.id == "hyprland" and .status == "ok")' <<<"$timed_doctor" >/dev/null || fail "Doctor timeout discarded successful checks"

privacy_canary="private-user private-host /home/private-user 192.0.2.44 SecretSSID journal-auth-token"
set +e
doctor_json="$(FIXTURE_HYPR_ERRORS="$privacy_canary" FIXTURE_SYSTEMCTL_FAILURE="$privacy_canary" "$ROOT/bin/omapanel" doctor --json)"
doctor_rc=$?
set -e
[[ $doctor_rc == 2 ]] || fail "Doctor error exit code"
jq -e '.schemaVersion == 1 and .kind == "omapanel.doctor" and (.checks | length) == 11' <<<"$doctor_json" >/dev/null || fail "public Doctor JSON schema"
[[ $doctor_json != *private-user* && $doctor_json != *private-host* && $doctor_json != *192.0.2.44* && $doctor_json != *SecretSSID* && $doctor_json != *journal-auth-token* ]] || fail "Doctor report leaked private detail"

set +e
private_human="$(FIXTURE_HYPR_ERRORS="$privacy_canary" FIXTURE_SYSTEMCTL_FAILURE="$privacy_canary" "$ROOT/bin/omapanel" doctor)"
private_human_rc=$?
set -e
[[ $private_human_rc == 2 ]] || fail "human Doctor severity"
[[ $private_human != *private-user* && $private_human != *private-host* && $private_human != *192.0.2.44* && $private_human != *SecretSSID* && $private_human != *journal-auth-token* ]] || fail "human Doctor report leaked private detail"

set +e
doctor_human="$(FIXTURE_SHELL_FAIL=true "$ROOT/bin/omapanel" doctor)"
doctor_human_rc=$?
set -e
[[ $doctor_human_rc == 1 ]] || fail "Doctor warning exit code"
[[ $doctor_human == *"OmaPanel Doctor"* ]] || fail "human Doctor report"

report_file="$TMP/doctor.json"
set +e
"$ROOT/bin/omapanel" doctor --json --output "$report_file" >/dev/null
report_rc=$?
set -e
[[ $report_rc == 1 && -f $report_file && $(stat -c '%a' "$report_file") == 600 ]] || fail "Doctor report file"
if "$ROOT/bin/omapanel" doctor --json --output "$report_file" >/dev/null 2>&1; then
  fail "Doctor overwrote an existing report"
fi

export FIXTURE_CLIPBOARD="$TMP/clipboard"
set +e
"$ROOT/bin/omapanel" doctor --copy >/dev/null
copy_rc=$?
set -e
[[ $copy_rc == 1 && -s $FIXTURE_CLIPBOARD ]] || fail "Doctor clipboard report"
unset FIXTURE_CLIPBOARD

if "$ROOT/bin/omapanel" doctor --fix >/dev/null 2>&1; then
  fail "Doctor accepted a repair option"
fi

preview="$("$ROOT/scripts/omapanel-backend" action --dry-run package fixture-package)"
jq -e '.ok and .terminal and (.argv | index("FZF_DEFAULT_QUERY=fixture-package")) and (.argv | index("omarchy")) and (.argv | index("pkg")) and (.argv | index("remove")) and (.impactedLaunchers | length) == 3' <<<"$preview" >/dev/null || fail "package preview"
web_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run webapp fixture-web)"
jq -e '.ok and (.argv | index("fixture-web"))' <<<"$web_preview" >/dev/null || fail "web app preview"
copy_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run copy-report _)"
jq -e '.ok and (.destructive == false) and .adapter == "copy-report"' <<<"$copy_preview" >/dev/null || fail "report copy preview"
export FIXTURE_CLIPBOARD="$TMP/panel-clipboard"
copy_result="$("$ROOT/scripts/omapanel-backend" action copy-report _)"
jq -e '.ok and (.message | ascii_downcase | contains("privacy-reviewed"))' <<<"$copy_result" >/dev/null || fail "report copy action"
[[ -s $FIXTURE_CLIPBOARD && $(<"$FIXTURE_CLIPBOARD") == *"OmaPanel Doctor"* ]] || fail "panel report clipboard"
unset FIXTURE_CLIPBOARD
if "$ROOT/scripts/omapanel-backend" action --dry-run package '../unsafe' >/dev/null 2>&1; then
  fail "unsafe target accepted"
fi

config="$TMP/config"
mkdir -p "$config/omarchy/extensions" "$config/hypr"
cat >"$config/omarchy/extensions/omarchy-menu.jsonc" <<'EOF'
{
  // URLs inside strings must survive the JSONC editor.
  "personal.docs": {"label":"Docs","action":"omarchy-launch-webapp 'https://example.test/a//b'"},
}
EOF
echo '-- Existing user binding' >"$config/hypr/bindings.lua"
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null
[[ $(grep -c 'setup.omapanel' "$config/omarchy/extensions/omarchy-menu.jsonc") == 1 ]] || fail "menu setup is not idempotent"
[[ $(grep -c '^o.bind("SUPER + I"' "$config/hypr/bindings.lua") == 1 ]] || fail "binding setup is not idempotent"
grep -q 'https://example.test/a//b' "$config/omarchy/extensions/omarchy-menu.jsonc" || fail "JSONC string changed"
[[ -L $HOME/.local/bin/omapanel && $(readlink -f "$HOME/.local/bin/omapanel") == "$ROOT/bin/omapanel" ]] || fail "CLI link setup"
[[ $("$HOME/.local/bin/omapanel" --version) == 0.5.0 ]] || fail "linked CLI execution"
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" --remove >/dev/null
! grep -q 'setup.omapanel' "$config/omarchy/extensions/omarchy-menu.jsonc" || fail "menu removal failed"
! grep -q '^o.bind("SUPER + I"' "$config/hypr/bindings.lua" || fail "binding removal failed"
[[ ! -e $HOME/.local/bin/omapanel && ! -L $HOME/.local/bin/omapanel ]] || fail "CLI link removal failed"

mkdir -p "$HOME/.local/bin"
printf '#!/bin/bash\n' >"$HOME/.local/bin/omapanel"
if OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null 2>&1; then
  fail "setup replaced an unrelated CLI command"
fi
[[ ! -L $HOME/.local/bin/omapanel ]] || fail "unrelated CLI command became a symlink"

if command -v qmltestrunner >/dev/null 2>&1; then
  QT_QPA_PLATFORM=offscreen qmltestrunner -input "$ROOT/tests/tst_model.qml"
fi

echo "All OmaPanel tests passed."
