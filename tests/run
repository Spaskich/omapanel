#!/bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

mkdir -p "$TMP/bin" "$TMP/home/.local/share/applications" "$TMP/system/share/applications"
cp "$ROOT"/tests/fixtures/home/.local/share/applications/*.desktop "$TMP/home/.local/share/applications/"
cp "$ROOT"/tests/fixtures/system/share/applications/*.desktop "$TMP/system/share/applications/"

cat >"$TMP/bin/pacman" <<'EOF'
#!/bin/bash
case "${1:-}" in
  -Ql)
    printf 'fixture-package %s\n' \
      "$XDG_DATA_DIRS/applications/fixture-package.desktop" \
      "$XDG_DATA_DIRS/applications/fixture-package-helper.desktop" \
      "$XDG_DATA_DIRS/applications/fixture-package-hidden.desktop"
    ;;
  -Qqm) printf '%s\n' fixture-package ;;
  -Qqe) printf '%s\n' fixture-package ;;
  -Qqdt) exit 1 ;;
  -Qqo)
    [[ ${2:-} == *fixture-package*.desktop ]] && { echo fixture-package; exit 0; }
    exit 1
    ;;
  -Q)
    if [[ $# == 1 ]]; then echo 'fixture-package 1.2.3-1'
    elif [[ ${2:-} == fixture-package ]]; then echo 'fixture-package 1.2.3-1'
    else exit 1
    fi
    ;;
  *) exit 1 ;;
esac
EOF

cat >"$TMP/bin/omarchy" <<'EOF'
#!/bin/bash
if [[ ${1:-} == plugin && ${2:-} == list ]]; then
  echo '[{"id":"omarchy.fixture","name":"System Fixture","kinds":["panel"],"enabled":true,"firstParty":true},{"id":"fixture.community","name":"Community Fixture","kinds":["panel"],"enabled":true,"firstParty":false}]'
elif [[ ${1:-} == version && ${2:-} == channel ]]; then echo stable
elif [[ ${1:-} == version && ${2:-} == pkgs ]]; then echo today
elif [[ ${1:-} == version ]]; then echo 4.0.0-test
elif [[ ${1:-} == theme && ${2:-} == current ]]; then echo 'Fixture Night'
elif [[ ${1:-} == theme && ${2:-} == bg && ${3:-} == current ]]; then echo 'Fixture Hills'
elif [[ ${1:-} == font && ${2:-} == current ]]; then [[ ${FIXTURE_FONT_FAIL:-false} != true ]] && echo 'Fixture Mono'
elif [[ ${1:-} == font && ${2:-} == list ]]; then [[ ${FIXTURE_FONT_FAIL:-false} != true ]] && printf '%s\n' 'Fixture Mono' 'Second Mono'
elif [[ ${1:-} == font && ${2:-} == set ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == display && ${2:-} == text && ${3:-} == size && $# == 3 ]]; then
  printf '%s\n' 'text size: 12 px' 'gtk text-scaling-factor: 1.0' 'terminal font: 9 pt'
elif [[ ${1:-} == display && ${2:-} == text && ${3:-} == size ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == bar && ${2:-} =~ ^(position|transparent)$ ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == toggle && ${2:-} == bar && ${3:-} == toggle ]]; then
  flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/bar-off"
  mkdir -p "$(dirname "$flag")"
  if [[ -e $flag ]]; then rm -f "$flag"; else touch "$flag"; fi
  printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
elif [[ ${1:-} == monitor && ${2:-} == state ]]; then
  printf '%s\n' 42 eDP-1 HDMI-A-1 eDP-1 '' eDP-1 1.25 '[{"name":"eDP-1","enabled":true,"focused":true,"width":1920,"height":1080},{"name":"HDMI-A-1","enabled":false,"focused":false,"width":2560,"height":1440}]'
elif [[ ${1:-} == menu || ${1:-} == shell ]]; then printf '%s\n' "$*" >>"$FIXTURE_ACTION_LOG"
else exit 0
fi
EOF

cat >"$TMP/bin/flatpak" <<'EOF'
#!/bin/bash
[[ ${1:-} == list ]] && exit 0
exit 1
EOF

cat >"$TMP/bin/hyprctl" <<'EOF'
#!/bin/bash
if [[ ${1:-} == binds ]]; then
  echo '[]'
elif [[ ${1:-} == configerrors && -n ${FIXTURE_HYPR_ERRORS:-} ]]; then
  printf '%s\n' "$FIXTURE_HYPR_ERRORS"
else
  exit 0
fi
EOF

cat >"$TMP/bin/systemctl" <<'EOF'
#!/bin/bash
[[ -z ${FIXTURE_SYSTEMCTL_SLEEP:-} ]] || sleep "$FIXTURE_SYSTEMCTL_SLEEP"
if [[ -n ${FIXTURE_SYSTEMCTL_FAILURE:-} ]]; then
  printf '%s\n' "$FIXTURE_SYSTEMCTL_FAILURE"
fi
exit 0
EOF

cat >"$TMP/bin/mise" <<'EOF'
#!/bin/bash
if [[ ${FIXTURE_MISE_FAIL:-false} == true ]]; then exit 1; fi
if [[ ${1:-} == ls && ${2:-} == --installed && ${3:-} == --json ]]; then
  cat <<'JSON'
{"node":[{"version":"22.1.0","installed":true,"active":true,"install_path":"/private/node","source":{"path":"/private/mise.toml"}},{"version":"20.0.0","installed":true,"active":false}],"python":[{"version":"3.13.0","installed":false,"active":true}]}
JSON
else
  exit 1
fi
EOF

for name in omarchy-shell xdg-terminal-exec snapper; do
  cat >"$TMP/bin/$name" <<'EOF'
#!/bin/bash
exit 0
EOF
done

cat >"$TMP/bin/omarchy-shell" <<'EOF'
#!/bin/bash
[[ ${FIXTURE_SHELL_FAIL:-false} != true ]]
EOF

cat >"$TMP/bin/wl-copy" <<'EOF'
#!/bin/bash
if [[ -n ${FIXTURE_CLIPBOARD:-} ]]; then
  tee "$FIXTURE_CLIPBOARD" >/dev/null
else
  cat >/dev/null
fi
EOF
chmod +x "$TMP/bin"/*

export PATH="$TMP/bin:/usr/bin:/bin"
export HOME="$TMP/home"
export XDG_CONFIG_HOME="$TMP/home/.config"
export XDG_DATA_HOME="$TMP/home/.local/share"
export XDG_DATA_DIRS="$TMP/system/share"
export XDG_STATE_HOME="$TMP/home/.local/state"
export FIXTURE_ACTION_LOG="$TMP/appearance-actions"

mkdir -p "$HOME/.config/omarchy" "$XDG_STATE_HOME/omarchy/current/theme/backgrounds"
cat >"$HOME/.config/omarchy/shell.json" <<'EOF'
{"version":1,"bar":{"position":"bottom","transparent":true,"layout":{"left":[],"center":[],"right":[]}},"plugins":[]}
EOF
touch "$XDG_STATE_HOME/omarchy/current/theme/backgrounds/0-fixture-hills.jpg"
ln -s "$XDG_STATE_HOME/omarchy/current/theme/backgrounds/0-fixture-hills.jpg" "$XDG_STATE_HOME/omarchy/current/background"

programs="$("$ROOT/scripts/omapanel-backend" collect programs)"
jq -e '.schemaVersion == 1 and (.programs | length) == 10' <<<"$programs" >/dev/null || fail "unexpected program count"
jq -e '.programs[] | select(.id == "desktop:fixture-web" and .kind == "webapp" and .actionAdapter == "webapp")' <<<"$programs" >/dev/null || fail "web app classification"
jq -e '.programs[] | select(.id == "desktop:fixture-tui" and .kind == "tui")' <<<"$programs" >/dev/null || fail "TUI classification"
jq -e '.programs[] | select(.id == "desktop:fixture-package" and .sourceId == "fixture-package")' <<<"$programs" >/dev/null || fail "package ownership"
jq -e '.programs[] | select(.id == "plugin:fixture.community" and .removable == true)' <<<"$programs" >/dev/null || fail "community plugin"
jq -e '.programs[] | select(.id == "plugin:omarchy.fixture" and .protected == true)' <<<"$programs" >/dev/null || fail "protected plugin"
jq -e '.programs[] | select(.id == "mise:node@22.1.0" and .kind == "mise" and .active == true and .removable == false and .actionAdapter == "")' <<<"$programs" >/dev/null || fail "Mise visibility-only tool"
jq -e '.programs[] | select(.id == "package:fixture-package" and .impactLauncherCount == 3 and (.impactLauncherNames | index("Fixture Package Hidden Helper")) and (.impactLauncherNamesText | contains("Fixture Package Hidden Helper")))' <<<"$programs" >/dev/null || fail "package launcher impact"
jq -e '.providers.mise == "ok" and (.errors | length) == 0' <<<"$programs" >/dev/null || fail "Mise provider status"

programs_without_mise="$(FIXTURE_MISE_FAIL=true "$ROOT/scripts/omapanel-backend" collect programs)"
jq -e '.providers.mise == "error" and (.errors[] | select(.provider == "mise")) and ([.programs[] | select(.kind == "mise")] | length == 0) and ([.programs[] | select(.kind == "app")] | length > 0)' <<<"$programs_without_mise" >/dev/null || fail "Mise provider failure isolation"

appearance="$("$ROOT/scripts/omapanel-backend" collect appearance)"
jq -e '.schemaVersion == 1 and .theme.current == "Fixture Night" and .background.current == "Fixture Hills" and (.background.path | endswith("0-fixture-hills.jpg"))' <<<"$appearance" >/dev/null || fail "appearance style state"
jq -e '.font.current == "Fixture Mono" and .font.installed == ["Fixture Mono","Second Mono"] and .textSize.currentPx == 12' <<<"$appearance" >/dev/null || fail "appearance typography state"
jq -e '.bar == {state:"ok",visible:true,position:"bottom",transparent:true}' <<<"$appearance" >/dev/null || fail "appearance bar state"
jq -e '.display.state == "ok" and .display.focusedMonitor == "eDP-1" and .display.scale == "1.25" and .display.brightnessPercent == 42 and .display.count == 2 and .display.enabledCount == 1 and .display.focusedWidth == 1920' <<<"$appearance" >/dev/null || fail "appearance display state"

appearance_without_fonts="$(FIXTURE_FONT_FAIL=true "$ROOT/scripts/omapanel-backend" collect appearance)"
jq -e '.font.state == "unavailable" and (.errors[] | select(.provider == "font")) and .theme.state == "ok" and .display.state == "ok"' <<<"$appearance_without_fonts" >/dev/null || fail "appearance provider failure isolation"

font_result="$("$ROOT/scripts/omapanel-backend" appearance set font 'Second Mono')"
jq -e '.ok and .setting == "font" and .value == "Second Mono"' <<<"$font_result" >/dev/null || fail "font setting result"
grep -Fx 'font set Second Mono' "$FIXTURE_ACTION_LOG" >/dev/null || fail "font setting handoff"
if "$ROOT/scripts/omapanel-backend" appearance set font 'Missing Mono' >/dev/null 2>&1; then fail "unknown font accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance set text-size 13 >/dev/null 2>&1; then fail "unsupported text size accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance set bar-position diagonal >/dev/null 2>&1; then fail "unsupported bar position accepted"; fi
if "$ROOT/scripts/omapanel-backend" appearance handoff '../unsafe' >/dev/null 2>&1; then fail "unknown appearance handoff accepted"; fi
"$ROOT/scripts/omapanel-backend" appearance set text-size 14 >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-position left >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-transparency false >/dev/null
"$ROOT/scripts/omapanel-backend" appearance set bar-visible false >/dev/null
[[ -e $XDG_STATE_HOME/omarchy/toggles/bar-off ]] || fail "bar was not hidden"
"$ROOT/scripts/omapanel-backend" appearance set bar-visible false >/dev/null
[[ $(grep -c '^toggle bar toggle$' "$FIXTURE_ACTION_LOG") == 1 ]] || fail "bar desired state toggled twice"
"$ROOT/scripts/omapanel-backend" appearance set bar-visible true >/dev/null
[[ ! -e $XDG_STATE_HOME/omarchy/toggles/bar-off ]] || fail "bar was not shown"
"$ROOT/scripts/omapanel-backend" appearance handoff theme
"$ROOT/scripts/omapanel-backend" appearance handoff background
"$ROOT/scripts/omapanel-backend" appearance handoff font-install
"$ROOT/scripts/omapanel-backend" appearance handoff display
grep -Fx 'menu summon style.theme' "$FIXTURE_ACTION_LOG" >/dev/null || fail "theme picker handoff"
grep -Fx 'menu summon style.background' "$FIXTURE_ACTION_LOG" >/dev/null || fail "background picker handoff"
grep -Fx 'menu summon install.style.font' "$FIXTURE_ACTION_LOG" >/dev/null || fail "font install handoff"
grep -Fx 'shell omarchy.monitor show' "$FIXTURE_ACTION_LOG" >/dev/null || fail "display panel handoff"

doctor="$("$ROOT/scripts/omapanel-backend" collect doctor)"
jq -e '.schemaVersion == 2 and (.checks | length) == 11 and .overall.counts.total == 11' <<<"$doctor" >/dev/null || fail "Doctor schema"
jq -e '.checks[] | select(.id == "hyprland" and .status == "ok")' <<<"$doctor" >/dev/null || fail "Doctor healthy check"

timed_doctor="$(FIXTURE_SYSTEMCTL_SLEEP=0.2 OMAPANEL_CHECK_TIMEOUT=0.05 "$ROOT/scripts/omapanel-backend" collect doctor)"
jq -e '[.checks[] | select((.id == "user-services" or .id == "system-services") and .status == "unknown" and .failureReason == "timeout")] | length == 2' <<<"$timed_doctor" >/dev/null || fail "Doctor timeout isolation"
jq -e '.checks[] | select(.id == "hyprland" and .status == "ok")' <<<"$timed_doctor" >/dev/null || fail "Doctor timeout discarded successful checks"

privacy_canary="private-user private-host /home/private-user 192.0.2.44 SecretSSID journal-auth-token"
set +e
doctor_json="$(FIXTURE_HYPR_ERRORS="$privacy_canary" FIXTURE_SYSTEMCTL_FAILURE="$privacy_canary" "$ROOT/bin/omapanel" doctor --json)"
doctor_rc=$?
set -e
[[ $doctor_rc == 2 ]] || fail "Doctor error exit code"
jq -e '.schemaVersion == 1 and .kind == "omapanel.doctor" and (.checks | length) == 11' <<<"$doctor_json" >/dev/null || fail "public Doctor JSON schema"
[[ $doctor_json != *private-user* && $doctor_json != *private-host* && $doctor_json != *192.0.2.44* && $doctor_json != *SecretSSID* && $doctor_json != *journal-auth-token* ]] || fail "Doctor report leaked private detail"

set +e
private_human="$(FIXTURE_HYPR_ERRORS="$privacy_canary" FIXTURE_SYSTEMCTL_FAILURE="$privacy_canary" "$ROOT/bin/omapanel" doctor)"
private_human_rc=$?
set -e
[[ $private_human_rc == 2 ]] || fail "human Doctor severity"
[[ $private_human != *private-user* && $private_human != *private-host* && $private_human != *192.0.2.44* && $private_human != *SecretSSID* && $private_human != *journal-auth-token* ]] || fail "human Doctor report leaked private detail"

set +e
doctor_human="$(FIXTURE_SHELL_FAIL=true "$ROOT/bin/omapanel" doctor)"
doctor_human_rc=$?
set -e
[[ $doctor_human_rc == 1 ]] || fail "Doctor warning exit code"
[[ $doctor_human == *"OmaPanel Doctor"* ]] || fail "human Doctor report"

report_file="$TMP/doctor.json"
set +e
"$ROOT/bin/omapanel" doctor --json --output "$report_file" >/dev/null
report_rc=$?
set -e
[[ $report_rc == 1 && -f $report_file && $(stat -c '%a' "$report_file") == 600 ]] || fail "Doctor report file"
if "$ROOT/bin/omapanel" doctor --json --output "$report_file" >/dev/null 2>&1; then
  fail "Doctor overwrote an existing report"
fi

export FIXTURE_CLIPBOARD="$TMP/clipboard"
set +e
"$ROOT/bin/omapanel" doctor --copy >/dev/null
copy_rc=$?
set -e
[[ $copy_rc == 1 && -s $FIXTURE_CLIPBOARD ]] || fail "Doctor clipboard report"
unset FIXTURE_CLIPBOARD

if "$ROOT/bin/omapanel" doctor --fix >/dev/null 2>&1; then
  fail "Doctor accepted a repair option"
fi

preview="$("$ROOT/scripts/omapanel-backend" action --dry-run package fixture-package)"
jq -e '.ok and .terminal and (.argv | index("FZF_DEFAULT_QUERY=fixture-package")) and (.argv | index("omarchy")) and (.argv | index("pkg")) and (.argv | index("remove")) and (.impactedLaunchers | length) == 3' <<<"$preview" >/dev/null || fail "package preview"
web_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run webapp fixture-web)"
jq -e '.ok and (.argv | index("fixture-web"))' <<<"$web_preview" >/dev/null || fail "web app preview"
copy_preview="$("$ROOT/scripts/omapanel-backend" action --dry-run copy-report _)"
jq -e '.ok and (.destructive == false) and .adapter == "copy-report"' <<<"$copy_preview" >/dev/null || fail "report copy preview"
export FIXTURE_CLIPBOARD="$TMP/panel-clipboard"
copy_result="$("$ROOT/scripts/omapanel-backend" action copy-report _)"
jq -e '.ok and (.message | ascii_downcase | contains("privacy-reviewed"))' <<<"$copy_result" >/dev/null || fail "report copy action"
[[ -s $FIXTURE_CLIPBOARD && $(<"$FIXTURE_CLIPBOARD") == *"OmaPanel Doctor"* ]] || fail "panel report clipboard"
unset FIXTURE_CLIPBOARD
if "$ROOT/scripts/omapanel-backend" action --dry-run package '../unsafe' >/dev/null 2>&1; then
  fail "unsafe target accepted"
fi

config="$TMP/config"
mkdir -p "$config/omarchy/extensions" "$config/hypr"
cat >"$config/omarchy/extensions/omarchy-menu.jsonc" <<'EOF'
{
  // URLs inside strings must survive the JSONC editor.
  "personal.docs": {"label":"Docs","action":"omarchy-launch-webapp 'https://example.test/a//b'"},
}
EOF
echo '-- Existing user binding' >"$config/hypr/bindings.lua"
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null
[[ $(grep -c 'setup.omapanel' "$config/omarchy/extensions/omarchy-menu.jsonc") == 1 ]] || fail "menu setup is not idempotent"
[[ $(grep -c '^o.bind("SUPER + I"' "$config/hypr/bindings.lua") == 1 ]] || fail "binding setup is not idempotent"
grep -q 'https://example.test/a//b' "$config/omarchy/extensions/omarchy-menu.jsonc" || fail "JSONC string changed"
[[ -L $HOME/.local/bin/omapanel && $(readlink -f "$HOME/.local/bin/omapanel") == "$ROOT/bin/omapanel" ]] || fail "CLI link setup"
[[ $("$HOME/.local/bin/omapanel" --version) == 0.3.0 ]] || fail "linked CLI execution"
OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" --remove >/dev/null
! grep -q 'setup.omapanel' "$config/omarchy/extensions/omarchy-menu.jsonc" || fail "menu removal failed"
! grep -q '^o.bind("SUPER + I"' "$config/hypr/bindings.lua" || fail "binding removal failed"
[[ ! -e $HOME/.local/bin/omapanel && ! -L $HOME/.local/bin/omapanel ]] || fail "CLI link removal failed"

mkdir -p "$HOME/.local/bin"
printf '#!/bin/bash\n' >"$HOME/.local/bin/omapanel"
if OMAPANEL_CONFIG_HOME="$config" OMAPANEL_SKIP_RUNTIME=true "$ROOT/setup" >/dev/null 2>&1; then
  fail "setup replaced an unrelated CLI command"
fi
[[ ! -L $HOME/.local/bin/omapanel ]] || fail "unrelated CLI command became a symlink"

if command -v qmltestrunner >/dev/null 2>&1; then
  QT_QPA_PLATFORM=offscreen qmltestrunner -input "$ROOT/tests/tst_model.qml"
fi

echo "All OmaPanel tests passed."
