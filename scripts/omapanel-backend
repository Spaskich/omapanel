#!/bin/bash

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROGRAM_SCHEMA_VERSION=1
DOCTOR_SCHEMA_VERSION=2
DOCTOR_REPORT_SCHEMA_VERSION=1
APPEARANCE_SCHEMA_VERSION=1
DEVICE_SCHEMA_VERSION=1
CHECK_TIMEOUT="${OMAPANEL_CHECK_TIMEOUT:-3}"
[[ $CHECK_TIMEOUT =~ ^[0-9]+([.][0-9]+)?$ ]] || CHECK_TIMEOUT=3
OMAPANEL_VERSION="$(jq -r '.version // "unknown"' "$ROOT/manifest.json" 2>/dev/null || printf unknown)"

usage() {
  cat <<'EOF'
Usage:
  omapanel-backend collect programs
  omapanel-backend collect programs --jsonl
  omapanel-backend collect doctor
  omapanel-backend collect health
  omapanel-backend collect appearance
  omapanel-backend collect devices
  omapanel-backend appearance set <font|text-size|bar-position|bar-transparency|bar-visible> <value>
  omapanel-backend appearance handoff <theme|background|unlock|font-install|display>
  omapanel-backend devices set touchpad <true|false>
  omapanel-backend devices handoff <display|audio|bluetooth|network|monitor-config|input-config>
  omapanel-backend doctor [--json] [--copy | --output <path>]
  omapanel-backend action [--dry-run] <adapter> <target>
EOF
}

json_lines_to_array() {
  if (( $# == 0 )); then
    printf '[]\n'
  else
    printf '%s\n' "$@" | jq -s '.'
  fi
}

desktop_value() {
  local file="$1" key="$2"
  awk -v wanted="$key" '
    BEGIN { in_desktop = 0 }
    /^\[Desktop Entry\][[:space:]]*$/ { in_desktop = 1; next }
    /^\[/ { if (in_desktop) exit; next }
    in_desktop {
      pos = index($0, "=")
      if (pos == 0) next
      key = substr($0, 1, pos - 1)
      if (key == wanted) {
        print substr($0, pos + 1)
        exit
      }
    }
  ' "$file"
}

application_dirs() {
  local dir
  local -a system_data_dirs=()
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  printf '%s\n' "$HOME/.local/share/flatpak/exports/share/applications"
  IFS=: read -ra system_data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "${system_data_dirs[@]}"; do
    printf '%s\n' "$dir/applications"
  done
  printf '%s\n' /var/lib/flatpak/exports/share/applications
}

program_json() {
  local id="$1" name="$2" description="$3" icon="$4" kind="$5"
  local source="$6" source_id="$7" version="$8" removable="$9"
  local protected="${10}" adapter="${11}" target="${12}" action_label="${13}"
  local workflow="${14}" warning="${15}" advanced="${16}"

  jq -cn \
    --arg id "$id" \
    --arg name "$name" \
    --arg description "$description" \
    --arg icon "$icon" \
    --arg kind "$kind" \
    --arg source "$source" \
    --arg sourceId "$source_id" \
    --arg version "$version" \
    --argjson removable "$removable" \
    --argjson protected "$protected" \
    --arg actionAdapter "$adapter" \
    --arg actionTarget "$target" \
    --arg actionLabel "$action_label" \
    --arg workflow "$workflow" \
    --arg warning "$warning" \
    --argjson advanced "$advanced" \
    '{id:$id,name:$name,description:$description,icon:$icon,kind:$kind,
      source:$source,sourceId:$sourceId,version:$version,
      removable:$removable,protected:$protected,
      actionAdapter:$actionAdapter,actionTarget:$actionTarget,
      actionLabel:$actionLabel,workflow:$workflow,warning:$warning,
      advanced:$advanced,
      searchText:([$name,$description,$kind,$source,$sourceId] | join(" ") | ascii_downcase)}'
}

collect_desktop_programs() {
  local package_owners="${1:-}"
  local -a rows=()
  local -a data_dirs=()
  local -A seen=()
  local -A foreign=()
  local -A owner_by_path=()
  local file dir desktop_id name description icon exec_line hidden no_display
  local kind source source_id version removable protected adapter target label workflow warning
  local package_owner flatpak_id x_flatpak

  while IFS= read -r package_owner; do
    [[ -n $package_owner ]] && foreign["$package_owner"]=1
  done < <(pacman -Qqm 2>/dev/null || true)
  while IFS=$'\t' read -r package_owner file; do
    [[ -n $package_owner && -n $file ]] && owner_by_path["$file"]="$package_owner"
  done <<<"$package_owners"

  mapfile -t data_dirs < <(application_dirs)

  shopt -s nullglob
  for dir in "${data_dirs[@]}"; do
    [[ -d $dir ]] || continue
    for file in "$dir"/*.desktop; do
      desktop_id="${file##*/}"
      desktop_id="${desktop_id%.desktop}"
      [[ -n ${seen[$desktop_id]+x} ]] && continue
      seen["$desktop_id"]=1

      hidden="$(desktop_value "$file" Hidden)"
      no_display="$(desktop_value "$file" NoDisplay)"
      [[ ${hidden,,} == true || ${no_display,,} == true ]] && continue

      name="$(desktop_value "$file" Name)"
      [[ -n $name ]] || name="$desktop_id"
      description="$(desktop_value "$file" Comment)"
      [[ -n $description ]] || description="$(desktop_value "$file" GenericName)"
      icon="$(desktop_value "$file" Icon)"
      exec_line="$(desktop_value "$file" Exec)"
      x_flatpak="$(desktop_value "$file" X-Flatpak)"

      kind="app"
      source="Local launcher"
      source_id="$desktop_id"
      version=""
      removable=false
      protected=true
      adapter=""
      target=""
      label=""
      workflow="No safe removal workflow was identified."
      warning="This entry is shown for visibility but cannot be removed by OmaPanel."

      if [[ $exec_line =~ omarchy-launch-webapp|omarchy-webapp-handler ]]; then
        kind="webapp"
        source="Omarchy Web App"
        removable=true
        protected=false
        adapter="webapp"
        target="$desktop_id"
        label="Remove web app"
        workflow="Omarchy will remove this web app launcher and its managed icon."
        warning="Only the web app launcher is removed; browser data is left intact."
      elif [[ $exec_line =~ (\$TERMINAL|xdg-terminal-exec).*-[eE]([[:space:]]|$) ]]; then
        kind="tui"
        source="TUI Launcher"
        removable=true
        protected=false
        adapter="tui"
        target="$desktop_id"
        label="Remove TUI launcher"
        workflow="Omarchy will remove this terminal application launcher and its managed icon."
        warning="The command or Mise tool behind the launcher is not uninstalled."
      elif [[ -n $x_flatpak || $file == *flatpak/exports/* ]]; then
        kind="flatpak"
        source="Flatpak"
        flatpak_id="${x_flatpak:-$desktop_id}"
        source_id="$flatpak_id"
        removable=true
        protected=false
        adapter="flatpak"
        target="$flatpak_id"
        label="Open Flatpak remover"
        workflow="A terminal will open the Flatpak uninstall workflow for $flatpak_id."
        warning="Flatpak may offer to remove unused application data or runtimes separately."
        version="$(flatpak info --show-version "$flatpak_id" 2>/dev/null || true)"
      elif package_owner="${owner_by_path[$file]:-}" && [[ -n $package_owner ]]; then
        source_id="$package_owner"
        version="$(pacman -Q "$package_owner" 2>/dev/null | awk '{print $2; exit}')"
        if [[ -n ${foreign[$package_owner]+x} ]]; then
          source="AUR / foreign package"
        else
          source="Pacman package"
        fi
        removable=true
        protected=false
        adapter="package"
        target="$package_owner"
        label="Open package remover"
        workflow="A terminal will open Omarchy's package remover with $package_owner prefilled."
        warning="Removing the package can also remove other launchers or dependencies it owns."
      elif [[ $file == "${XDG_DATA_HOME:-$HOME/.local/share}/applications/"* ]]; then
        kind="launcher"
        source="Local launcher"
        removable=true
        protected=false
        adapter="launcher"
        target="$desktop_id"
        label="Remove launcher"
        workflow="Omarchy will remove only the local .desktop launcher."
        warning="The executable and its data will not be deleted."
      fi

      rows+=("$(program_json \
        "desktop:$desktop_id" "$name" "$description" "$icon" "$kind" \
        "$source" "$source_id" "$version" "$removable" "$protected" \
        "$adapter" "$target" "$label" "$workflow" "$warning" false)")
    done
  done
  shopt -u nullglob

  json_lines_to_array "${rows[@]}"
}

package_desktop_owners() {
  pacman -Ql 2>/dev/null |
    awk '$2 ~ /\/share\/applications\/[^/]+[.]desktop$/ {print $1 "\t" $2}'
}

collect_package_launcher_impact() {
  local package_owners="${1:-}"
  local -a rows=()
  local -A seen=()
  local -A owner_by_path=()
  local dir file desktop_id name hidden no_display package_owner visible impact_id

  while IFS=$'\t' read -r package_owner file; do
    [[ -n $package_owner && -n $file ]] && owner_by_path["$file"]="$package_owner"
  done <<<"$package_owners"

  shopt -s nullglob
  while IFS= read -r dir; do
    [[ -d $dir ]] || continue
    for file in "$dir"/*.desktop; do
      desktop_id="${file##*/}"
      desktop_id="${desktop_id%.desktop}"
      package_owner="${owner_by_path[$file]:-}"
      [[ -n $package_owner ]] || continue
      impact_id="$package_owner:$desktop_id"
      [[ -n ${seen[$impact_id]+x} ]] && continue
      seen["$impact_id"]=1
      name="$(desktop_value "$file" Name)"
      [[ -n $name ]] || name="$desktop_id"
      hidden="$(desktop_value "$file" Hidden)"
      no_display="$(desktop_value "$file" NoDisplay)"
      visible=true
      if [[ ${hidden,,} == true || ${no_display,,} == true ]]; then
        visible=false
      fi
      rows+=("$(jq -cn \
        --arg package "$package_owner" --arg id "$desktop_id" --arg name "$name" \
        --argjson visible "$visible" \
        '{package:$package,id:$id,name:$name,visible:$visible}')")
    done
  done < <(application_dirs)
  shopt -u nullglob

  json_lines_to_array "${rows[@]}"
}

collect_plugins() {
  local raw
  if ! raw="$(omarchy plugin list --json 2>/dev/null)"; then
    printf '[]\n'
    return
  fi

  jq -c '[.[] | {
    id:("plugin:" + .id),
    name:(.name // .id),
    description:((.kinds // []) | join(", ")),
    icon:"󰏗",
    kind:"plugin",
    source:(if .firstParty then "Omarchy system plugin" else "Community plugin" end),
    sourceId:.id,
    version:"",
    removable:(.firstParty | not),
    protected:.firstParty,
    actionAdapter:(if .firstParty then "" else "plugin" end),
    actionTarget:(if .firstParty then "" else .id end),
    actionLabel:(if .firstParty then "" else "Open plugin remover" end),
    workflow:(if .firstParty then "First-party plugins are protected system components." else "A terminal will open the Omarchy interactive plugin removal workflow." end),
    warning:(if .firstParty then "It ships with Omarchy and cannot be uninstalled as a community plugin." else "The plugin will be disabled before its files are removed or backed up." end),
    advanced:false,
    enabled:(.enabled // false),
    searchText:([.name,.id,((.kinds // []) | join(" ")),"plugin"] | map(. // "") | join(" ") | ascii_downcase)
  }]' <<<"$raw"
}

collect_flatpaks_without_desktop() {
  command -v flatpak >/dev/null 2>&1 || { printf '[]\n'; return; }

  flatpak list --app --columns=application,name,version,description 2>/dev/null |
    jq -Rsc '
      split("\n")
      | map(select(length > 0) | split("\t"))
      | map({
          id:("flatpak:" + .[0]), name:(.[1] // .[0]), description:(.[3] // ""),
          icon:"", kind:"flatpak", source:"Flatpak", sourceId:.[0], version:(.[2] // ""),
          removable:true, protected:false, actionAdapter:"flatpak", actionTarget:.[0],
          actionLabel:"Open Flatpak remover",
          workflow:("A terminal will open the Flatpak uninstall workflow for " + .[0] + "."),
          warning:"Flatpak may offer to remove unused application data or runtimes separately.",
          advanced:false,
          searchText:([.[1],.[3],.[0],"flatpak"] | map(. // "") | join(" ") | ascii_downcase)
        })'
}

collect_explicit_packages() {
  local foreign_json
  foreign_json="$(pacman -Qqm 2>/dev/null | jq -Rsc 'split("\n") | map(select(length > 0))')"

  LC_ALL=C join \
    <(pacman -Q 2>/dev/null | LC_ALL=C sort) \
    <(pacman -Qqe 2>/dev/null | LC_ALL=C sort) |
    jq -Rsc --argjson foreign "$foreign_json" '
      split("\n")
      | map(select(length > 0) | split(" "))
      | map({
          id:("package:" + .[0]), name:.[0], description:"Explicitly installed package",
          icon:"󰣇", kind:"package",
          source:(if ($foreign | index(.[0])) then "AUR / foreign package" else "Pacman package" end),
          sourceId:.[0], version:(.[1] // ""), removable:true, protected:false,
          actionAdapter:"package", actionTarget:.[0], actionLabel:"Open package remover",
          workflow:("A terminal will open the Omarchy package remover with " + .[0] + " prefilled."),
          warning:"Review the Pacman dependency list before confirming removal.", advanced:true,
          searchText:([.[0],.[1],"package",(if ($foreign | index(.[0])) then "aur foreign" else "pacman" end)] | join(" ") | ascii_downcase)
        })'
}

collect_mise_tools() {
  local raw="$1"
  jq -c '
    to_entries
    | map(.key as $tool
        | .value[]
        | select(.installed == true)
        | {
            id:("mise:" + $tool + "@" + .version),
            name:($tool + " " + .version),
            description:"Development tool managed by Mise",
            icon:"󰏗", kind:"mise", source:"Mise-managed tool",
            sourceId:($tool + "@" + .version), version:.version,
            removable:false, protected:false,
            actionAdapter:"", actionTarget:"", actionLabel:"",
            workflow:"Mise owns this tool version. OmaPanel does not remove it because active mise.toml files may still request it.",
            warning:"Visibility only: mise uninstall removes files without updating the configuration that requested them.",
            advanced:true, active:(.active // false),
            impactLauncherIds:[], impactLauncherNames:[], impactLauncherNamesText:"", impactLauncherCount:0,
            searchText:([$tool,.version,"mise","development tool",(if .active then "active" else "inactive" end)] | join(" ") | ascii_downcase)
          })
    | sort_by(.name | ascii_downcase)
  ' <<<"$raw"
}

collect_programs() {
  local desktops plugins flatpaks packages mise_tools impact combined package_owners
  local mise_state="unavailable" mise_error="" mise_raw=""
  package_owners="$(package_desktop_owners)"
  desktops="$(collect_desktop_programs "$package_owners")"
  plugins="$(collect_plugins)"
  flatpaks="$(collect_flatpaks_without_desktop)"
  packages="$(collect_explicit_packages)"
  impact="$(collect_package_launcher_impact "$package_owners")"

  mise_tools='[]'
  if command -v mise >/dev/null 2>&1; then
    if mise_raw="$(timeout --foreground "$CHECK_TIMEOUT" mise ls --installed --json 2>/dev/null)"; then
      if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$mise_raw"; then
        mise_tools="$(collect_mise_tools "$mise_raw")"
        mise_state="ok"
      else
        mise_state="error"
        mise_error="Mise returned an unsupported inventory response."
      fi
    else
      case $? in
        124) mise_state="timeout"; mise_error="Mise inventory timed out." ;;
        *) mise_state="error"; mise_error="Mise inventory could not be read." ;;
      esac
    fi
  fi

  combined="$(printf '%s\n%s\n%s\n%s\n%s\n' "$desktops" "$plugins" "$flatpaks" "$packages" "$mise_tools" |
    jq -cs --argjson impact "$impact" '
      add
      | unique_by(.id)
      | map(
          if .actionAdapter == "package" then
            .sourceId as $package
            | ($impact | map(select(.package == $package))) as $launchers
            | . + {
                impactLauncherIds:($launchers | map(.id)),
                impactLauncherNames:($launchers | map(.name)),
                impactLauncherNamesText:($launchers | map(.name) | join("\n")),
                impactLauncherCount:($launchers | length)
              }
          else
            . + {
              impactLauncherIds:(.impactLauncherIds // []),
              impactLauncherNames:(.impactLauncherNames // []),
              impactLauncherNamesText:(.impactLauncherNamesText // ""),
              impactLauncherCount:(.impactLauncherCount // 0)
            }
          end)
      | sort_by(.name | ascii_downcase)')"

  printf '%s\n' "$combined" | jq -c \
    --argjson schemaVersion "$PROGRAM_SCHEMA_VERSION" \
    --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg miseState "$mise_state" \
    --arg miseError "$mise_error" \
    '{schemaVersion:$schemaVersion,generatedAt:$generatedAt,programs:.,
      providers:{desktopEntries:"ok",packages:"ok",plugins:"ok",
        flatpak:(if any(.[]; .kind == "flatpak") then "ok" else "unavailable" end),
        mise:$miseState},
      errors:(if $miseError == "" then [] else [{provider:"mise",message:$miseError}] end)}'
}

doctor_check_json() {
  local id="$1" category="$2" title="$3" status="$4" summary="$5"
  local detail="$6" report_summary="$7" recommendation="$8"
  local adapter="${9:-}" target="${10:-}" label="${11:-}" failure_reason="${12:-}"
  jq -cn \
    --arg id "$id" --arg category "$category" --arg title "$title" \
    --arg status "$status" --arg summary "$summary" --arg detail "$detail" \
    --arg reportSummary "$report_summary" --arg recommendation "$recommendation" \
    --arg actionAdapter "$adapter" --arg actionTarget "$target" \
    --arg actionLabel "$label" --arg failureReason "$failure_reason" \
    '{id:$id,category:$category,title:$title,status:$status,summary:$summary,
      detail:$detail,reportSummary:$reportSummary,recommendation:$recommendation,
      actionAdapter:$actionAdapter,actionTarget:$actionTarget,
      actionLabel:$actionLabel,failureReason:$failureReason}'
}

timed_capture() {
  local variable="$1"
  shift
  local output rc
  set +e
  output="$(timeout --foreground "$CHECK_TIMEOUT" "$@" 2>/dev/null)"
  rc=$?
  set -e
  printf -v "$variable" '%s' "$output"
  return "$rc"
}

device_error_json() {
  jq -cn --arg provider "$1" --arg message "$2" \
    '{provider:$provider,message:$message}'
}

collect_devices() {
  local display_state=unavailable display_output="" monitor_output="" displays_json='[]'
  local brightness_available=false brightness_percent=0 focused_monitor=""
  local input_state=unavailable input_output="" keyboards_json='[]' pointers_json='[]'
  local tablets_json='[]' touchscreens_json='[]' switches_json='[]' main_keyboard_json='null'
  local touchpad_name="" touchpad_present=false touchpad_enabled=false
  local network_state=unavailable network_output="" network_verbose=""
  local network_type=disconnected network_interface="" network_ssid="" network_signal=""
  local network_ip="" network_prefix=""
  local touchpad_flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/touchpad-disabled.lua"
  local key value
  local -a device_errors=()

  if command -v hyprctl >/dev/null 2>&1 && timed_capture display_output hyprctl monitors all -j &&
    jq -e 'type == "array" and all(.[]; (.name | type == "string"))' <<<"$display_output" >/dev/null 2>&1; then
    displays_json="$(jq -c '
      map({
        name:(.name // ""),
        label:(if (.model // "") != "" then .model else (.description // .name // "Display") end),
        make:(.make // ""), model:(.model // ""),
        enabled:(.disabled != true), focused:(.focused == true),
        width:((.width // 0) | tonumber), height:((.height // 0) | tonumber),
        refreshHz:((((.refreshRate // 0) | tonumber) * 100 | round) / 100),
        x:((.x // 0) | tonumber), y:((.y // 0) | tonumber),
        scale:((.scale // 1) | tonumber), transform:((.transform // 0) | tonumber)
      })
    ' <<<"$display_output")"
    focused_monitor="$(jq -r '[.[] | select(.focused)][0].name // ""' <<<"$displays_json")"
    display_state=ok
  else
    device_errors+=("$(device_error_json display 'Display details could not be read from Hyprland.')")
  fi

  if command -v omarchy >/dev/null 2>&1 && timed_capture monitor_output omarchy monitor state; then
    value="$(sed -n '1p' <<<"$monitor_output")"
    if [[ $value =~ ^[0-9]+$ ]] && (( value >= 0 && value <= 100 )); then
      brightness_available=true
      brightness_percent="$value"
    fi
  else
    device_errors+=("$(device_error_json brightness 'Display brightness information is unavailable.')")
  fi

  if command -v hyprctl >/dev/null 2>&1 && timed_capture input_output hyprctl devices -j &&
    jq -e 'type == "object" and (.keyboards | type == "array") and (.mice | type == "array")' \
      <<<"$input_output" >/dev/null 2>&1; then
    keyboards_json="$(jq -c '[.keyboards[]? | {
      name:(.name // "Keyboard"), main:(.main == true), keymap:(.active_keymap // "Unknown")
    }]' <<<"$input_output")"
    main_keyboard_json="$(jq -c '[.keyboards[]? | select(.main == true)][0] // .keyboards[0] // null |
      if . == null then null else {name:(.name // "Keyboard"),main:(.main == true),keymap:(.active_keymap // "Unknown")} end' \
      <<<"$input_output")"
    pointers_json="$(jq -c '[.mice[]? | {
      name:(.name // "Pointer"),
      kind:(if ((.name // "") | test("touchpad|trackpad"; "i")) then "touchpad" else "mouse" end),
      speed:((.defaultSpeed // 0) | tonumber), scrollFactor:((.scrollFactor // 1) | tonumber)
    }]' <<<"$input_output")"
    tablets_json="$(jq -c '[.tablets[]? | {name:(.name // "Tablet")}]' <<<"$input_output")"
    touchscreens_json="$(jq -c '[.touch[]? | {name:(.name // "Touchscreen")}]' <<<"$input_output")"
    switches_json="$(jq -c '[.switches[]? | {name:(.name // "Switch")}]' <<<"$input_output")"
    touchpad_name="$(jq -r '[.[] | select(.kind == "touchpad")][0].name // ""' <<<"$pointers_json")"
    if command -v omarchy >/dev/null 2>&1 && timed_capture value omarchy hw touchpad && [[ -n $value ]]; then
      touchpad_name="$value"
    fi
    if [[ -n $touchpad_name ]]; then
      touchpad_present=true
      [[ ! -e $touchpad_flag ]] && touchpad_enabled=true
    fi
    input_state=ok
  else
    device_errors+=("$(device_error_json input 'Input devices could not be read from Hyprland.')")
  fi

  if command -v omarchy >/dev/null 2>&1 && timed_capture network_output omarchy network status; then
    IFS=$'\t' read -r network_type value network_signal _ <<<"$network_output"
    case "$network_type" in
      wifi) network_ssid="$value" ;;
      ethernet) network_interface="$value" ;;
      disconnected) ;;
      *) network_type=unknown ;;
    esac
    network_state=ok

    if [[ $network_type != disconnected ]] && timed_capture network_verbose omarchy network status --verbose; then
      while IFS=$'\t' read -r key value; do
        case "$key" in
          iface) network_interface="$value" ;;
          ip) network_ip="$value" ;;
          prefix) network_prefix="$value" ;;
          ssid) [[ -n $value ]] && network_ssid="$value" ;;
        esac
      done <<<"$network_verbose"
    fi
  else
    device_errors+=("$(device_error_json network 'Network details could not be read from Omarchy.')")
  fi

  [[ $network_type =~ ^(wifi|ethernet|disconnected|unknown)$ ]] || network_type=unknown
  [[ $network_interface =~ ^[A-Za-z0-9_.:-]{0,64}$ ]] || network_interface=""
  [[ $network_ip =~ ^[A-Fa-f0-9:.]{0,64}$ ]] || network_ip=""
  [[ $network_prefix =~ ^[0-9]{0,3}$ ]] || network_prefix=""
  [[ $network_signal =~ ^[0-9]{0,3}$ ]] || network_signal=""
  network_ssid="${network_ssid//$'\n'/ }"
  network_ssid="${network_ssid//$'\r'/ }"
  (( ${#network_ssid} <= 128 )) || network_ssid="${network_ssid:0:128}"

  jq -cn \
    --argjson schemaVersion "$DEVICE_SCHEMA_VERSION" --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg displayState "$display_state" --arg focusedMonitor "$focused_monitor" \
    --argjson brightnessAvailable "$brightness_available" --argjson brightnessPercent "$brightness_percent" \
    --argjson displays "$displays_json" \
    --arg inputState "$input_state" --argjson mainKeyboard "$main_keyboard_json" \
    --argjson keyboards "$keyboards_json" --argjson pointers "$pointers_json" \
    --argjson tablets "$tablets_json" --argjson touchscreens "$touchscreens_json" --argjson switches "$switches_json" \
    --argjson touchpadPresent "$touchpad_present" --arg touchpadName "$touchpad_name" --argjson touchpadEnabled "$touchpad_enabled" \
    --arg networkState "$network_state" --arg networkType "$network_type" --arg networkInterface "$network_interface" \
    --arg networkSsid "$network_ssid" --arg networkSignal "$network_signal" --arg networkIp "$network_ip" --arg networkPrefix "$network_prefix" \
    --argjson errors "$(json_lines_to_array "${device_errors[@]}")" \
    '{schemaVersion:$schemaVersion,generatedAt:$generatedAt,
      display:{state:$displayState,focusedMonitor:$focusedMonitor,brightnessAvailable:$brightnessAvailable,
        brightnessPercent:$brightnessPercent,displays:$displays},
      input:{state:$inputState,mainKeyboard:$mainKeyboard,keyboards:$keyboards,pointers:$pointers,
        tablets:$tablets,touchscreens:$touchscreens,switches:$switches,
        touchpad:{present:$touchpadPresent,name:$touchpadName,enabled:$touchpadEnabled}},
      network:{state:$networkState,type:$networkType,interface:$networkInterface,ssid:$networkSsid,
        signal:($networkSignal | if . == "" then null else tonumber end),ip:$networkIp,prefix:$networkPrefix},
      errors:$errors}'
}

device_result() {
  jq -cn --arg setting "$1" --argjson value "$2" --argjson previous "$3" --arg message "$4" \
    '{schemaVersion:1,ok:true,setting:$setting,value:$value,previous:$previous,message:$message}'
}

devices_set() {
  local setting="$1" value="$2" touchpad_name="" current=true requested action
  local touchpad_flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr/touchpad-disabled.lua"
  [[ $setting == touchpad ]] || { echo "Unknown device setting: $setting" >&2; return 2; }
  [[ $value =~ ^(true|false)$ ]] || { echo 'Touchpad state must be true or false.' >&2; return 2; }
  command -v omarchy >/dev/null 2>&1 || { echo 'The Omarchy command is unavailable.' >&2; return 1; }
  timed_capture touchpad_name omarchy hw touchpad || true
  [[ -n $touchpad_name ]] || { echo 'No touchpad was detected.' >&2; return 1; }

  [[ -e $touchpad_flag ]] && current=false
  requested="$value"
  if [[ $current != "$requested" ]]; then
    [[ $requested == true ]] && action=on || action=off
    omarchy toggle touchpad "$action" >/dev/null
  fi
  if { [[ $requested == true ]] && [[ -e $touchpad_flag ]]; } ||
    { [[ $requested == false ]] && [[ ! -e $touchpad_flag ]]; }; then
    echo 'Omarchy did not apply the requested touchpad state.' >&2
    return 1
  fi
  device_result touchpad "$requested" "$current" "Touchpad turned $([[ $requested == true ]] && printf on || printf off)."
}

devices_handoff() {
  local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  command -v omarchy >/dev/null 2>&1 || { echo 'The Omarchy command is unavailable.' >&2; return 1; }
  case "$1" in
    display) exec omarchy shell omarchy.monitor show ;;
    audio) exec omarchy shell omarchy.audio show ;;
    bluetooth) exec omarchy shell omarchy.bluetooth show ;;
    network) exec omarchy shell omarchy.network show ;;
    monitor-config)
      [[ -f $config_home/hypr/monitors.lua ]] || { echo 'The Omarchy monitor configuration is unavailable.' >&2; return 1; }
      exec omarchy launch config editor "$config_home/hypr/monitors.lua"
      ;;
    input-config)
      [[ -f $config_home/hypr/input.lua ]] || { echo 'The Omarchy input configuration is unavailable.' >&2; return 1; }
      exec omarchy launch config editor "$config_home/hypr/input.lua"
      ;;
    *) echo "Unknown device handoff: $1" >&2; return 2 ;;
  esac
}

appearance_error_json() {
  jq -cn --arg provider "$1" --arg message "$2" \
    '{provider:$provider,message:$message}'
}

collect_appearance() {
  local theme_state=unavailable theme_name=Unknown theme_output=""
  local background_state=unavailable background_name=Unknown background_path="" background_output=""
  local font_state=unavailable font_current=Unknown font_output="" font_list_output="" fonts_json='[]'
  local text_size_state=unavailable text_size_output="" text_size_px=0
  local bar_state=unavailable bar_position=top bar_transparent=false bar_visible=true
  local display_state=unavailable monitor_output="" brightness="" focused_monitor="" monitor_scale=""
  local displays_json='[]' enabled_display_count=0 display_count=0 focused_width=0 focused_height=0
  local brightness_available=false brightness_percent=0
  local shell_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
  local omarchy_root="${OMARCHY_PATH:-/usr/share/omarchy}"
  local default_shell_config="$omarchy_root/config/omarchy/shell.json"
  local bar_config=""
  local -a appearance_errors=()

  if command -v omarchy >/dev/null 2>&1; then
    if timed_capture theme_output omarchy theme current && [[ -n $theme_output ]]; then
      theme_name="$theme_output"
      theme_state=ok
    else
      appearance_errors+=("$(appearance_error_json theme 'The current Omarchy theme could not be read.')")
    fi

    if timed_capture background_output omarchy theme bg current && [[ -n $background_output ]]; then
      background_name="$background_output"
      background_path="$(readlink -f -- "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/background" 2>/dev/null || true)"
      [[ -f $background_path ]] || background_path=""
      background_state=ok
    else
      appearance_errors+=("$(appearance_error_json background 'The current Omarchy background could not be read.')")
    fi

    if timed_capture font_output omarchy font current && [[ -n $font_output ]] &&
      timed_capture font_list_output omarchy font list; then
      font_current="$font_output"
      fonts_json="$(printf '%s\n' "$font_list_output" | jq -Rsc 'split("\n") | map(select(length > 0)) | unique | sort')"
      if jq -e 'length > 0' <<<"$fonts_json" >/dev/null; then
        font_state=ok
      else
        appearance_errors+=("$(appearance_error_json font 'No installed monospace fonts were discovered.')")
      fi
    else
      appearance_errors+=("$(appearance_error_json font 'Installed fonts could not be read from Omarchy.')")
    fi

    if timed_capture text_size_output omarchy display text size; then
      text_size_px="$(sed -nE 's/^text size: ([0-9]+)( \(default\))? px$/\1/p' <<<"$text_size_output" | head -n1)"
      if [[ $text_size_px =~ ^([9]|1[0-9]|20)$ ]]; then
        text_size_state=ok
      else
        text_size_px=0
        appearance_errors+=("$(appearance_error_json text-size 'The current desktop text size was not recognized.')")
      fi
    else
      appearance_errors+=("$(appearance_error_json text-size 'The desktop text-size command is unavailable.')")
    fi
  else
    appearance_errors+=("$(appearance_error_json omarchy 'The Omarchy command is unavailable.')")
  fi

  if [[ -s $shell_config ]]; then
    bar_config="$shell_config"
  elif [[ -s $default_shell_config ]]; then
    bar_config="$default_shell_config"
  fi
  if [[ -n $bar_config ]] && jq -e '.bar | type == "object"' "$bar_config" >/dev/null 2>&1; then
    bar_position="$(jq -r '.bar.position // "top"' "$bar_config")"
    bar_transparent="$(jq -r '.bar.transparent // false' "$bar_config")"
    if [[ $bar_position =~ ^(top|bottom|left|right)$ ]] && [[ $bar_transparent =~ ^(true|false)$ ]]; then
      [[ -e ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/bar-off ]] && bar_visible=false
      bar_state=ok
    else
      appearance_errors+=("$(appearance_error_json bar 'The Omarchy bar configuration contains unsupported values.')")
    fi
  else
    appearance_errors+=("$(appearance_error_json bar 'The Omarchy bar configuration could not be read.')")
  fi

  if command -v omarchy >/dev/null 2>&1 && timed_capture monitor_output omarchy monitor state; then
    brightness="$(sed -n '1p' <<<"$monitor_output")"
    focused_monitor="$(sed -n '6p' <<<"$monitor_output")"
    monitor_scale="$(sed -n '7p' <<<"$monitor_output")"
    displays_json="$(sed -n '8p' <<<"$monitor_output")"
    if jq -e 'type == "array" and all(.[]; (.name | type == "string") and (.enabled | type == "boolean"))' \
      <<<"$displays_json" >/dev/null 2>&1; then
      display_count="$(jq 'length' <<<"$displays_json")"
      enabled_display_count="$(jq '[.[] | select(.enabled)] | length' <<<"$displays_json")"
      focused_width="$(jq -r --arg name "$focused_monitor" '[.[] | select(.name == $name)][0].width // 0' <<<"$displays_json")"
      focused_height="$(jq -r --arg name "$focused_monitor" '[.[] | select(.name == $name)][0].height // 0' <<<"$displays_json")"
      if [[ $brightness =~ ^[0-9]+$ ]] && (( brightness >= 0 && brightness <= 100 )); then
        brightness_available=true
        brightness_percent="$brightness"
      fi
      [[ $monitor_scale =~ ^[0-9]+([.][0-9]+)?$ ]] || monitor_scale=""
      display_state=ok
    else
      displays_json='[]'
      appearance_errors+=("$(appearance_error_json display 'The Omarchy display state was not recognized.')")
    fi
  else
    appearance_errors+=("$(appearance_error_json display 'The Omarchy display panel state is unavailable.')")
  fi

  jq -cn \
    --argjson schemaVersion "$APPEARANCE_SCHEMA_VERSION" \
    --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg themeState "$theme_state" --arg themeName "$theme_name" \
    --arg backgroundState "$background_state" --arg backgroundName "$background_name" --arg backgroundPath "$background_path" \
    --arg fontState "$font_state" --arg fontCurrent "$font_current" --argjson fonts "$fonts_json" \
    --arg textSizeState "$text_size_state" --argjson textSizePx "$text_size_px" \
    --arg barState "$bar_state" --arg barPosition "$bar_position" --argjson barTransparent "$bar_transparent" --argjson barVisible "$bar_visible" \
    --arg displayState "$display_state" --arg focusedMonitor "$focused_monitor" --arg monitorScale "$monitor_scale" \
    --argjson brightnessAvailable "$brightness_available" --argjson brightnessPercent "$brightness_percent" \
    --argjson displayCount "$display_count" --argjson enabledDisplayCount "$enabled_display_count" \
    --argjson focusedWidth "$focused_width" --argjson focusedHeight "$focused_height" --argjson displays "$displays_json" \
    --argjson errors "$(json_lines_to_array "${appearance_errors[@]}")" \
    '{schemaVersion:$schemaVersion,generatedAt:$generatedAt,
      theme:{state:$themeState,current:$themeName},
      background:{state:$backgroundState,current:$backgroundName,path:$backgroundPath},
      font:{state:$fontState,current:$fontCurrent,installed:$fonts},
      textSize:{state:$textSizeState,currentPx:$textSizePx,stops:[9,10,11,12,14,16,20]},
      bar:{state:$barState,visible:$barVisible,position:$barPosition,transparent:$barTransparent},
      display:{state:$displayState,focusedMonitor:$focusedMonitor,scale:$monitorScale,
        brightnessAvailable:$brightnessAvailable,brightnessPercent:$brightnessPercent,
        count:$displayCount,enabledCount:$enabledDisplayCount,
        focusedWidth:$focusedWidth,focusedHeight:$focusedHeight,displays:$displays},
      errors:$errors}'
}

appearance_result() {
  jq -cn --arg setting "$1" --arg value "$2" --arg message "$3" \
    '{schemaVersion:1,ok:true,setting:$setting,value:$value,message:$message}'
}

appearance_set() {
  local setting="$1" value="$2" current_visible requested_visible flag
  command -v omarchy >/dev/null 2>&1 || { echo 'The Omarchy command is unavailable.' >&2; return 1; }

  case "$setting" in
    font)
      [[ -n $value && ${#value} -le 160 && $value != *$'\n'* && $value != *$'\r'* ]] || {
        echo 'Invalid font family.' >&2; return 2;
      }
      omarchy font list 2>/dev/null | grep -Fx -- "$value" >/dev/null || {
        echo "The selected font is not in Omarchy's installed-font list." >&2; return 2;
      }
      omarchy font set "$value" >/dev/null
      appearance_result font "$value" "Font changed to $value."
      ;;
    text-size)
      [[ $value =~ ^(9|10|11|12|14|16|20)$ ]] || {
        echo 'Text size must be one of 9, 10, 11, 12, 14, 16, or 20.' >&2; return 2;
      }
      omarchy display text size "$value" >/dev/null
      appearance_result text-size "$value" "Text size changed to ${value}px."
      ;;
    bar-position)
      [[ $value =~ ^(top|bottom|left|right)$ ]] || {
        echo 'Bar position must be top, bottom, left, or right.' >&2; return 2;
      }
      omarchy bar position "$value" >/dev/null
      appearance_result bar-position "$value" "Bar moved to the $value."
      ;;
    bar-transparency)
      [[ $value =~ ^(true|false)$ ]] || { echo 'Bar transparency must be true or false.' >&2; return 2; }
      omarchy bar transparent "$value" >/dev/null
      appearance_result bar-transparency "$value" "Bar transparency updated."
      ;;
    bar-visible)
      [[ $value =~ ^(true|false)$ ]] || { echo 'Bar visibility must be true or false.' >&2; return 2; }
      flag="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/bar-off"
      current_visible=true
      [[ -e $flag ]] && current_visible=false
      requested_visible="$value"
      if [[ $current_visible != "$requested_visible" ]]; then
        omarchy toggle bar toggle >/dev/null
      fi
      if { [[ $requested_visible == true ]] && [[ -e $flag ]]; } ||
        { [[ $requested_visible == false ]] && [[ ! -e $flag ]]; }; then
        echo 'Omarchy did not apply the requested bar visibility.' >&2
        return 1
      fi
      appearance_result bar-visible "$value" "Bar visibility updated."
      ;;
    *) echo "Unknown appearance setting: $setting" >&2; return 2 ;;
  esac
}

appearance_handoff() {
  local selection=""
  command -v omarchy >/dev/null 2>&1 || { echo 'The Omarchy command is unavailable.' >&2; return 1; }
  case "$1" in
    theme)
      command -v omarchy-theme-switcher >/dev/null 2>&1 || { echo 'The Omarchy theme picker is unavailable.' >&2; return 1; }
      command -v omarchy-theme-set >/dev/null 2>&1 || { echo 'The Omarchy theme setter is unavailable.' >&2; return 1; }
      selection="$(omarchy-theme-switcher)" || selection=""
      [[ -z $selection ]] || omarchy-theme-set "$selection"
      ;;
    background)
      command -v omarchy-theme-bg-switcher >/dev/null 2>&1 || { echo 'The Omarchy background picker is unavailable.' >&2; return 1; }
      command -v omarchy-theme-bg-set >/dev/null 2>&1 || { echo 'The Omarchy background setter is unavailable.' >&2; return 1; }
      selection="$(omarchy-theme-bg-switcher)" || selection=""
      [[ -z $selection ]] || omarchy-theme-bg-set "$selection"
      ;;
    unlock) exec omarchy menu summon style.unlock ;;
    font-install) exec omarchy menu summon install.style.font ;;
    display) exec omarchy shell omarchy.monitor show ;;
    *) echo "Unknown appearance handoff: $1" >&2; return 2 ;;
  esac
}

check_omarchy() {
  local version="" channel="" packages_date="" rc
  if ! command -v omarchy >/dev/null 2>&1; then
    doctor_check_json omarchy Omarchy Omarchy error \
      "The Omarchy command is missing" \
      "OmaPanel could not find the omarchy command on PATH." \
      "The Omarchy command is unavailable." \
      "Restore the Omarchy installation before using its recovery workflows." \
      "" "" "" unavailable
    return
  fi

  if timed_capture version omarchy version; then
    timed_capture channel omarchy version channel || channel="unknown channel"
    timed_capture packages_date omarchy version pkgs || packages_date="unknown"
    [[ $version =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]] || version="unknown"
    [[ $channel =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || channel="unknown"
    doctor_check_json omarchy Omarchy Omarchy ok \
      "$version · ${channel:-unknown channel}" \
      "Packages last upgraded: ${packages_date:-unknown}" \
      "Omarchy ${version:-unknown} is installed on the ${channel:-unknown} channel." \
      "Use Omarchy's update workflow when you intentionally want to check for updates."
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json omarchy Omarchy Omarchy unknown \
        "The version check timed out" \
        "The omarchy command did not answer within ${CHECK_TIMEOUT}s." \
        "The Omarchy version check timed out." \
        "Verify the command from a terminal before attempting an update." \
        "" "" "" timeout
    else
      doctor_check_json omarchy Omarchy Omarchy unknown \
        "The version could not be read" \
        "The omarchy command returned an error." \
        "The Omarchy version check failed." \
        "Run 'omarchy version' in a terminal and review its error." \
        "" "" "" failed
    fi
  fi
}

check_shell() {
  local output="" rc
  if ! command -v omarchy-shell >/dev/null 2>&1; then
    doctor_check_json shell Desktop "Quattro shell" error \
      "omarchy-shell is missing" \
      "The Quattro shell executable is not available on PATH." \
      "The Quattro shell executable is unavailable." \
      "Restore the Omarchy shell package; Doctor will not reinstall it automatically." \
      "" "" "" unavailable
    return
  fi
  if timed_capture output omarchy-shell shell ping; then
    doctor_check_json shell Desktop "Quattro shell" ok \
      "The shell is responding" \
      "Quattro answered its local shell ping." \
      "The Quattro shell is responding." \
      "No action is needed."
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json shell Desktop "Quattro shell" unknown \
        "The shell ping timed out" \
        "Quattro did not answer within ${CHECK_TIMEOUT}s." \
        "The Quattro shell check timed out." \
        "From a terminal, review the shell and run 'omarchy restart shell' only if you choose to restart it." \
        "" "" "" timeout
    else
      doctor_check_json shell Desktop "Quattro shell" warning \
        "The shell is not responding" \
        "The shell ping failed. The terminal Doctor remains available independently." \
        "The Quattro shell did not respond." \
        "From a terminal, run 'omarchy restart shell' if you choose to restart it." \
        "" "" "" failed
    fi
  fi
}

check_hyprland() {
  local errors="" rc count
  if ! command -v hyprctl >/dev/null 2>&1; then
    doctor_check_json hyprland Desktop "Hyprland configuration" unknown \
      "hyprctl is unavailable" \
      "OmaPanel could not inspect the active Hyprland configuration." \
      "The Hyprland configuration could not be checked." \
      "Restore hyprctl or run the check inside an active Hyprland session." \
      "" "" "" unavailable
    return
  fi
  if timed_capture errors hyprctl configerrors; then
    if [[ -z $errors ]]; then
      doctor_check_json hyprland Desktop "Hyprland configuration" ok \
        "No configuration errors" \
        "The active Hyprland configuration parsed successfully." \
        "No active Hyprland configuration errors were reported." \
        "No action is needed."
    else
      count="$(wc -l <<<"$errors" | tr -d ' ')"
      doctor_check_json hyprland Desktop "Hyprland configuration" error \
        "$count configuration error(s) detected" "$errors" \
        "$count active Hyprland configuration error(s) were detected." \
        "Review the local error details before editing the configuration." \
        open-hypr-config _ "Open configuration"
    fi
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json hyprland Desktop "Hyprland configuration" unknown \
        "The configuration check timed out" \
        "hyprctl did not answer within ${CHECK_TIMEOUT}s." \
        "The Hyprland configuration check timed out." \
        "Run 'hyprctl configerrors' inside the active session." \
        "" "" "" timeout
    else
      doctor_check_json hyprland Desktop "Hyprland configuration" unknown \
        "The active configuration could not be read" \
        "hyprctl returned an error, commonly because no Hyprland session is active." \
        "The Hyprland configuration could not be checked." \
        "Run the check inside the active Hyprland session." \
        "" "" "" failed
    fi
  fi
}

check_services() {
  local scope="$1" id title output="" rc count args=()
  if [[ $scope == user ]]; then
    id="user-services"
    title="User services"
    args=(--user --failed --no-legend --plain)
  else
    id="system-services"
    title="System services"
    args=(--failed --no-legend --plain)
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    doctor_check_json "$id" Services "$title" unknown \
      "systemctl is unavailable" \
      "OmaPanel could not query failed units." \
      "$title could not be checked." \
      "Restore systemctl before diagnosing services." \
      "" "" "" unavailable
    return
  fi
  if timed_capture output systemctl "${args[@]}"; then
    if [[ -z $output ]]; then
      doctor_check_json "$id" Services "$title" ok \
        "No failed units" "systemd reports no failed $scope units." \
        "No failed $scope services were reported." "No action is needed."
    else
      count="$(wc -l <<<"$output" | tr -d ' ')"
      doctor_check_json "$id" Services "$title" warning \
        "$count failed unit(s) detected" "$output" \
        "$count failed $scope service unit(s) were detected." \
        "Review the journal before deciding whether a service needs treatment." \
        "journal-$scope" _ "View journal"
    fi
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json "$id" Services "$title" unknown \
        "The service check timed out" \
        "systemctl did not answer within ${CHECK_TIMEOUT}s." \
        "$title timed out during diagnosis." \
        "Run the equivalent systemctl command locally." \
        "" "" "" timeout
    else
      doctor_check_json "$id" Services "$title" unknown \
        "The service state could not be read" \
        "systemctl returned an error." \
        "$title could not be checked." \
        "Run the equivalent systemctl command locally." \
        "" "" "" failed
    fi
  fi
}

check_disk() {
  local id="$1" title="$2" path="$3" line="" rc percent available status summary recommendation
  if timed_capture line df -P -B1 "$path"; then
    line="$(awk 'NR==2 {print $3, $4, $5}' <<<"$line")"
    if [[ -z $line ]]; then
      doctor_check_json "$id" Storage "$title" unknown \
        "Usage could not be parsed" "df returned no filesystem row." \
        "$title usage could not be parsed." \
        "Inspect the filesystem with 'df -h'." "" "" "" failed
      return
    fi
    read -r _ available percent <<<"$line"
    percent="${percent%%%}"
    summary="$percent% used · $(numfmt --to=iec-i --suffix=B "$available" 2>/dev/null || printf '%s bytes' "$available") free"
    if (( percent >= 90 )); then
      status=error
      recommendation="Inspect large files before removing anything; OmaPanel does not perform cleanup."
    elif (( percent >= 80 )); then
      status=warning
      recommendation="Review storage usage before the filesystem becomes critically full."
    else
      status=ok
      recommendation="No action is needed."
    fi
    doctor_check_json "$id" Storage "$title" "$status" "$summary" \
      "$summary" "$title is $percent% used." "$recommendation"
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json "$id" Storage "$title" unknown \
        "The filesystem check timed out" \
        "df did not answer within ${CHECK_TIMEOUT}s." \
        "$title usage timed out during diagnosis." \
        "Inspect the filesystem with 'df -h'." "" "" "" timeout
    else
      doctor_check_json "$id" Storage "$title" unknown \
        "Usage could not be read" "df returned an error." \
        "$title usage could not be read." \
        "Inspect the filesystem with 'df -h'." "" "" "" failed
    fi
  fi
}

check_restart_state() {
  local restart_markers
  restart_markers="$(
    find "$HOME/.local/state/omarchy" -maxdepth 1 -type f \
      \( -name 'reboot-required' -o -name 'restart-*-required' \) \
      -printf '%f\n' 2>/dev/null | sort | paste -sd ', ' - || true
  )"
  if [[ -n $restart_markers ]]; then
    doctor_check_json restart-state Omarchy "Restart state" warning \
      "A restart is pending" "$restart_markers" \
      "Omarchy recorded a pending reboot or service restart." \
      "Open Omarchy's restart review and choose when to apply it." \
      update-restart _ "Open restart review"
  else
    doctor_check_json restart-state Omarchy "Restart state" ok \
      "No restart markers" \
      "Omarchy has not recorded a pending reboot or service restart." \
      "No pending Omarchy restart marker was found." "No action is needed."
  fi
}

check_pacman_lock() {
  if [[ -e ${OMAPANEL_PACMAN_LOCK:-/var/lib/pacman/db.lck} ]]; then
    doctor_check_json pacman-lock Omarchy "Package database" warning \
      "The package database is locked" \
      "A package operation may be active. A lock alone does not prove that Pacman is stuck." \
      "A Pacman database lock is present." \
      "Wait for active package operations and investigate their state; never delete the lock merely because Doctor found it."
  else
    doctor_check_json pacman-lock Omarchy "Package database" ok \
      "The package database is available" \
      "No Pacman database lock is present." \
      "No Pacman database lock is present." "No action is needed."
  fi
}

check_snapshots() {
  local raw="" rc count detail
  if ! command -v snapper >/dev/null 2>&1; then
    doctor_check_json snapshots Recovery "Recovery snapshots" info \
      "Snapper is not installed" \
      "Snapshot recovery is unavailable on this system." \
      "Snapper is not installed." \
      "Doctor will not install or configure snapshot recovery automatically."
    return
  fi
  if timed_capture raw snapper --csvout list-configs; then
    detail="$(awk -F, 'NR>1 && $1 != "" {print $1}' <<<"$raw" | paste -sd ', ' -)"
    count="$(awk -F, 'NR>1 && $1 != "" {count++} END {print count+0}' <<<"$raw")"
    if (( count > 0 )); then
      doctor_check_json snapshots Recovery "Recovery snapshots" ok \
        "$count Snapper configuration(s) available" \
        "Configured snapshot scopes: $detail. Snapshot contents were not read." \
        "$count Snapper configuration(s) are available." \
        "Review snapshots through Omarchy only when recovery is necessary."
    else
      doctor_check_json snapshots Recovery "Recovery snapshots" warning \
        "Snapper has no configuration" \
        "The command is installed but no snapshot scope was reported." \
        "Snapper is installed without a configured snapshot scope." \
        "Review Omarchy's snapshot setup before relying on snapshot recovery."
    fi
  else
    rc=$?
    if (( rc == 124 )); then
      doctor_check_json snapshots Recovery "Recovery snapshots" unknown \
        "The snapshot check timed out" \
        "snapper did not answer within ${CHECK_TIMEOUT}s." \
        "The Snapper configuration check timed out." \
        "Inspect Snapper locally before relying on recovery." \
        "" "" "" timeout
    else
      doctor_check_json snapshots Recovery "Recovery snapshots" unknown \
        "Snapshot configuration could not be read" \
        "snapper returned an error without OmaPanel requesting privilege." \
        "The Snapper configuration could not be checked." \
        "Inspect Snapper locally; Doctor will not request privilege." \
        "" "" "" failed
    fi
  fi
}

check_omapanel() {
  local missing="" required cli_path="" summary recommendation status detail report_summary
  for required in jq timeout pacman xdg-terminal-exec; do
    command -v "$required" >/dev/null 2>&1 || missing+="${missing:+, }$required"
  done
  if [[ -n $missing ]]; then
    doctor_check_json omapanel OmaPanel "OmaPanel installation" error \
      "Required commands are missing" "$missing" \
      "OmaPanel is missing required local commands: $missing." \
      "Restore the missing dependencies before using all OmaPanel features." \
      "" "" "" unavailable
    return
  fi

  if [[ ! -x $ROOT/scripts/omapanel-backend || ! -x $ROOT/bin/omapanel ]] ||
    ! jq -e '.id == "spaskich.omapanel" and (.version | type == "string")' "$ROOT/manifest.json" >/dev/null 2>&1; then
    doctor_check_json omapanel OmaPanel "OmaPanel installation" error \
      "Plugin files are incomplete" \
      "The manifest, backend, or CLI entry point is missing or invalid." \
      "The OmaPanel installation is incomplete." \
      "Reinstall the plugin from its trusted repository; Doctor will not replace files automatically." \
      "" "" "" failed
    return
  fi

  cli_path="$(command -v omapanel 2>/dev/null || true)"
  if [[ -z $cli_path ]]; then
    status=info
    summary="The plugin is healthy; the CLI is not linked"
    detail="Run the plugin's setup script to add ~/.local/bin/omapanel."
    report_summary="The OmaPanel plugin is valid, but its optional CLI link is not on PATH."
    recommendation="Run setup again if you want to call 'omapanel doctor' without its full path."
  else
    status=ok
    summary="Plugin and CLI files are valid"
    detail="OmaPanel $OMAPANEL_VERSION passed its local integrity checks."
    report_summary="OmaPanel $OMAPANEL_VERSION passed its local integrity checks."
    recommendation="No action is needed."
  fi
  doctor_check_json omapanel OmaPanel "OmaPanel installation" "$status" \
    "$summary" "$detail" "$report_summary" "$recommendation"
}

collect_doctor() {
  local -a rows=()
  rows+=("$(check_omarchy)")
  rows+=("$(check_restart_state)")
  rows+=("$(check_pacman_lock)")
  rows+=("$(check_shell)")
  rows+=("$(check_hyprland)")
  rows+=("$(check_services user)")
  rows+=("$(check_services system)")
  rows+=("$(check_disk root-disk "Root filesystem" /)")
  rows+=("$(check_disk home-disk "Home filesystem" "$HOME")")
  rows+=("$(check_snapshots)")
  rows+=("$(check_omapanel)")

  json_lines_to_array "${rows[@]}" |
    jq -c \
      --argjson schemaVersion "$DOCTOR_SCHEMA_VERSION" \
      --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
      def rank: if . == "error" then 4 elif . == "warning" then 3
        elif . == "unknown" then 2 elif . == "info" then 1 else 0 end;
      . as $checks
      | ($checks | group_by(.status) | map({key:.[0].status,value:length}) | from_entries) as $rawCounts
      | ($rawCounts + {
          ok:($rawCounts.ok // 0), info:($rawCounts.info // 0),
          warning:($rawCounts.warning // 0), error:($rawCounts.error // 0),
          unknown:($rawCounts.unknown // 0), total:($checks | length)
        }) as $counts
      | ($checks | map(.status) | max_by(rank)) as $status
      | {
          schemaVersion:$schemaVersion,generatedAt:$generatedAt,checks:$checks,
          overall:{status:$status,counts:$counts},
          errors:($checks
            | map(select(.failureReason != "")
              | {checkId:.id,reason:.failureReason}))
        }'
}

doctor_report_json() {
  local diagnostics="$1"
  jq -c \
    --argjson schemaVersion "$DOCTOR_REPORT_SCHEMA_VERSION" \
    --arg omapanelVersion "$OMAPANEL_VERSION" '
      {
        schemaVersion:$schemaVersion,
        kind:"omapanel.doctor",
        generatedAt:.generatedAt,
        omapanelVersion:$omapanelVersion,
        overall:.overall,
        checks:(.checks | map({
          id,category,title,status,
          summary:.reportSummary,
          recommendation
        })),
        errors:.errors
      }
    ' <<<"$diagnostics"
}

render_doctor_human() {
  local report="$1"
  jq -r '
    "OmaPanel Doctor " + .omapanelVersion,
    "Generated: " + .generatedAt,
    "Overall: " + (.overall.status | ascii_upcase)
      + " · " + (.overall.counts.error | tostring) + " error"
      + " · " + (.overall.counts.warning | tostring) + " warning"
      + " · " + (.overall.counts.unknown | tostring) + " unknown",
    "",
    (.checks[]
      | "[" + (.status | ascii_upcase) + "] " + .category + " / " + .title + "\n"
        + "  " + .summary
        + (if .recommendation == "" then "" else "\n  Next: " + .recommendation end))
  ' <<<"$report"
}

render_doctor_human_color() {
  local report="$1" line color reset=$'\033[0m'
  while IFS= read -r line; do
    color=""
    case "$line" in
      '[OK]'*) color=$'\033[32m' ;;
      '[INFO]'*) color=$'\033[36m' ;;
      '[WARNING]'*) color=$'\033[33m' ;;
      '[ERROR]'*) color=$'\033[31m' ;;
      '[UNKNOWN]'*) color=$'\033[35m' ;;
    esac
    if [[ -n $color ]]; then
      printf '%s%s%s\n' "$color" "$line" "$reset"
    else
      printf '%s\n' "$line"
    fi
  done < <(render_doctor_human "$report")
}

doctor_exit_code() {
  local report="$1" status
  status="$(jq -r '.overall.status' <<<"$report")"
  case "$status" in
    error) return 2 ;;
    warning|unknown) return 1 ;;
    *) return 0 ;;
  esac
}

write_report_file() {
  local path="$1" content="$2" parent base temporary
  parent="$(dirname -- "$path")"
  base="$(basename -- "$path")"
  [[ -d $parent ]] || {
    echo "Report directory does not exist: $parent" >&2
    return 1
  }
  [[ ! -e $path && ! -L $path ]] || {
    echo "Refusing to overwrite existing report: $path" >&2
    return 1
  }

  umask 077
  temporary="$(mktemp --tmpdir="$parent" ".${base}.omapanel.XXXXXX")" || return 1
  if ! printf '%s\n' "$content" >"$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  chmod 0600 "$temporary"
  if ! ln -- "$temporary" "$path" 2>/dev/null; then
    rm -f -- "$temporary"
    echo "Could not publish report without overwriting a file: $path" >&2
    return 1
  fi
  rm -f -- "$temporary"
}

run_doctor_cli() {
  local json=false copy=false output_path="" diagnostics report content result=0
  while (( $# > 0 )); do
    case "$1" in
      --json) json=true ;;
      --copy) copy=true ;;
      --output)
        shift
        [[ $# -gt 0 ]] || { echo "--output requires a path" >&2; return 3; }
        output_path="$1"
        ;;
      -h|--help)
        cat <<'EOF'
Usage: omapanel doctor [--json] [--copy | --output <path>]

Run privilege-free diagnostics. Human-readable output is the default.
--json emits a stable, privacy-reviewed document. --copy copies the human
report. --output writes the selected format to a new mode-0600 file.
Nothing is uploaded or sent automatically.
EOF
        return 0
        ;;
      *) echo "Unknown doctor option: $1" >&2; return 3 ;;
    esac
    shift
  done

  if $copy && [[ -n $output_path ]]; then
    echo "--copy and --output cannot be combined" >&2
    return 3
  fi
  if $copy && $json; then
    echo "--copy always uses the human report and cannot be combined with --json" >&2
    return 3
  fi

  diagnostics="$(collect_doctor)" || {
    echo "OmaPanel Doctor could not collect diagnostics." >&2
    return 3
  }
  report="$(doctor_report_json "$diagnostics")" || {
    echo "OmaPanel Doctor could not build its privacy-reviewed report." >&2
    return 3
  }
  doctor_exit_code "$report" || result=$?

  if $json; then
    content="$(jq '.' <<<"$report")"
  else
    content="$(render_doctor_human "$report")"
  fi

  if $copy; then
    command -v wl-copy >/dev/null 2>&1 || {
      echo "wl-copy is unavailable; use stdout or --output instead." >&2
      return 3
    }
    if ! printf '%s\n' "$content" | wl-copy; then
      echo "The Wayland clipboard is unavailable; use stdout or --output instead." >&2
      return 3
    fi
    echo "Copied a privacy-reviewed Doctor report to the clipboard." >&2
  elif [[ -n $output_path ]]; then
    write_report_file "$output_path" "$content" || return 3
    echo "Saved Doctor report to $output_path" >&2
  elif ! $json && [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    render_doctor_human_color "$report"
  else
    printf '%s\n' "$content"
  fi

  return "$result"
}

validate_target() {
  local adapter="$1" target="$2"
  local desktop_file
  [[ ${#target} -le 240 ]] || { echo "Target is too long" >&2; return 1; }
  [[ $target != *$'\n'* && $target != *$'\r'* && $target != *'/'* && $target != *'..'* ]] || {
    echo "Unsafe target" >&2
    return 1
  }

  case "$adapter" in
    package)
      [[ $target =~ ^[A-Za-z0-9@._+:-]+$ ]] && pacman -Q "$target" >/dev/null 2>&1
      ;;
    plugin)
      [[ $target =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] &&
        omarchy plugin list --json 2>/dev/null |
          jq -e --arg id "$target" '.[] | select(.id == $id and (.firstParty | not))' >/dev/null
      ;;
    flatpak)
      [[ $target =~ ^[A-Za-z0-9][A-Za-z0-9._-]+$ ]] && flatpak info "$target" >/dev/null 2>&1
      ;;
    webapp)
      [[ -n $target && $target != *[[:cntrl:]]* ]]
      desktop_file="${XDG_DATA_HOME:-$HOME/.local/share}/applications/$target.desktop"
      [[ -f $desktop_file ]] && grep -qE '^Exec=.*(omarchy-launch-webapp|omarchy-webapp-handler)' "$desktop_file"
      ;;
    tui)
      [[ -n $target && $target != *[[:cntrl:]]* ]]
      desktop_file="${XDG_DATA_HOME:-$HOME/.local/share}/applications/$target.desktop"
      [[ -f $desktop_file ]] && grep -qE '^Exec=.*([$]TERMINAL|xdg-terminal-exec).*(-e|-[[:alpha:]]*e)([[:space:]]|$)' "$desktop_file"
      ;;
    launcher)
      [[ -n $target && $target != *[[:cntrl:]]* ]]
      desktop_file="${XDG_DATA_HOME:-$HOME/.local/share}/applications/$target.desktop"
      [[ -f $desktop_file ]]
      ;;
    update|update-restart|restart-shell|journal-user|journal-system|open-hypr-config|snapshot-create|snapshot-restore|review-orphans|copy-report)
      [[ $target == _ ]]
      ;;
    *)
      echo "Unknown action adapter: $adapter" >&2
      return 1
      ;;
  esac
}

action_spec() {
  local adapter="$1" target="$2"
  ACTION_LABEL=""
  ACTION_WORKFLOW=""
  ACTION_TERMINAL=false
  ACTION_DESTRUCTIVE=true
  ACTION_ARGV=()

  case "$adapter" in
    package)
      ACTION_LABEL="Open package remover"
      ACTION_WORKFLOW="Omarchy's package remover will open with $target prefilled. Review Pacman's dependency list before accepting."
      ACTION_TERMINAL=true
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal env "FZF_DEFAULT_QUERY=$target" omarchy pkg remove)
      ;;
    webapp)
      ACTION_LABEL="Remove web app"
      ACTION_WORKFLOW="Omarchy will remove the $target web app launcher and its managed icon. Browser data remains."
      ACTION_ARGV=(omarchy webapp remove "$target")
      ;;
    tui)
      ACTION_LABEL="Remove TUI launcher"
      ACTION_WORKFLOW="Omarchy will remove the $target terminal launcher and its managed icon. The underlying command remains installed."
      ACTION_ARGV=(omarchy tui remove "$target")
      ;;
    plugin)
      ACTION_LABEL="Open plugin remover"
      ACTION_WORKFLOW="Omarchy's interactive plugin workflow will disable and remove or back up $target."
      ACTION_TERMINAL=true
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy plugin remove "$target")
      ;;
    flatpak)
      ACTION_LABEL="Open Flatpak remover"
      ACTION_WORKFLOW="Flatpak will review and uninstall $target in a terminal."
      ACTION_TERMINAL=true
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal flatpak uninstall "$target")
      ;;
    launcher)
      ACTION_LABEL="Remove launcher"
      ACTION_WORKFLOW="Omarchy will remove only the local $target.desktop launcher. The executable and its data remain."
      ACTION_ARGV=(omarchy-remove-launcher-entry "$target" "$target")
      ;;
    update)
      ACTION_LABEL="Open update workflow"
      ACTION_WORKFLOW="A terminal will open Omarchy's standard update workflow. It may check the network and request sudo."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy update)
      ;;
    update-restart)
      ACTION_LABEL="Open restart review"
      ACTION_WORKFLOW="A terminal will open Omarchy's restart review. Omarchy will ask before applying a reboot or service restart."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy update restart)
      ;;
    restart-shell)
      ACTION_LABEL="Restart shell"
      ACTION_WORKFLOW="Omarchy-shell will restart. OmaPanel will close with it and can be reopened after the shell returns."
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(omarchy restart shell)
      ;;
    journal-user)
      ACTION_LABEL="View user journal"
      ACTION_WORKFLOW="A terminal will show warnings from this boot's user journal."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal bash -lc 'journalctl --user -b -p warning; printf "\nPress Enter to close..."; read -r')
      ;;
    journal-system)
      ACTION_LABEL="View system journal"
      ACTION_WORKFLOW="A terminal will show warnings from this boot's system journal."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal bash -lc 'journalctl -b -p warning; printf "\nPress Enter to close..."; read -r')
      ;;
    open-hypr-config)
      ACTION_LABEL="Open configuration"
      ACTION_WORKFLOW="Omarchy will open your Hyprland configuration in the configured editor."
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(omarchy launch config-editor "$HOME/.config/hypr/hyprland.lua")
      ;;
    snapshot-create)
      ACTION_LABEL="Create snapshot"
      ACTION_WORKFLOW="A terminal will run Omarchy's Snapper snapshot workflow and may request sudo."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy snapshot create)
      ;;
    snapshot-restore)
      ACTION_LABEL="Open snapshot restore"
      ACTION_WORKFLOW="A terminal will open Omarchy's boot snapshot restore workflow. Review the selected snapshot carefully."
      ACTION_TERMINAL=true
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy snapshot restore)
      ;;
    review-orphans)
      ACTION_LABEL="Review orphaned packages"
      ACTION_WORKFLOW="A terminal will open Omarchy's interactive orphan package review."
      ACTION_TERMINAL=true
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(xdg-terminal-exec --app-id=org.omarchy.terminal omarchy update orphan pkgs)
      ;;
    copy-report)
      ACTION_LABEL="Copy diagnostic report"
      ACTION_WORKFLOW="OmaPanel will copy a sanitized health summary without logs or personal files."
      ACTION_DESTRUCTIVE=false
      ACTION_ARGV=(__copy_report__)
      ;;
  esac
}

action_preview() {
  local adapter="$1" target="$2" argv_json impact_json='[]'
  action_spec "$adapter" "$target"
  argv_json="$(printf '%s\n' "${ACTION_ARGV[@]}" | jq -R . | jq -s '.')"
  if [[ $adapter == package ]]; then
    impact_json="$(collect_package_launcher_impact "$(package_desktop_owners)" | jq -c --arg package "$target" '
      [.[] | select(.package == $package) | {id,name,visible}]')"
  fi
  jq -cn \
    --arg adapter "$adapter" --arg target "$target" \
    --arg label "$ACTION_LABEL" --arg workflow "$ACTION_WORKFLOW" \
    --argjson terminal "$ACTION_TERMINAL" --argjson destructive "$ACTION_DESTRUCTIVE" \
    --argjson argv "$argv_json" --argjson impactedLaunchers "$impact_json" \
    '{ok:true,adapter:$adapter,target:$target,label:$label,workflow:$workflow,
      terminal:$terminal,destructive:$destructive,argv:$argv,
      impactedLaunchers:$impactedLaunchers}'
}

copy_report() {
  local diagnostics report human
  command -v wl-copy >/dev/null 2>&1 || {
    echo "wl-copy is unavailable" >&2
    return 1
  }
  diagnostics="$(collect_doctor)"
  report="$(doctor_report_json "$diagnostics")"
  human="$(render_doctor_human "$report")"
  printf '%s\n' "$human" | wl-copy
  jq -cn '{ok:true,message:"Privacy-reviewed Doctor report copied to the clipboard."}'
}

run_action() {
  local dry_run="$1" adapter="$2" target="$3"
  validate_target "$adapter" "$target" || exit 2
  if [[ $dry_run == true ]]; then
    action_preview "$adapter" "$target"
    return
  fi

  action_spec "$adapter" "$target"
  if [[ ${ACTION_ARGV[0]} == __copy_report__ ]]; then
    copy_report
    return
  fi
  exec "${ACTION_ARGV[@]}"
}

main() {
  case "${1:-}" in
    collect)
      case "${2:-}" in
        programs)
          if [[ ${3:-} == --jsonl ]]; then
            collect_programs | jq -c '.programs[]'
          elif [[ -z ${3:-} ]]; then
            collect_programs
          else
            usage
            exit 2
          fi
          ;;
        doctor|health)
          [[ -z ${3:-} ]] || { usage; exit 2; }
          collect_doctor
          ;;
        appearance)
          [[ -z ${3:-} ]] || { usage; exit 2; }
          collect_appearance
          ;;
        devices)
          [[ -z ${3:-} ]] || { usage; exit 2; }
          collect_devices
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    devices)
      case "${2:-}" in
        set)
          [[ $# == 4 ]] || { usage; exit 2; }
          devices_set "$3" "$4"
          ;;
        handoff)
          [[ $# == 3 ]] || { usage; exit 2; }
          devices_handoff "$3"
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    appearance)
      case "${2:-}" in
        set)
          [[ $# == 4 ]] || { usage; exit 2; }
          appearance_set "$3" "$4"
          ;;
        handoff)
          [[ $# == 3 ]] || { usage; exit 2; }
          appearance_handoff "$3"
          ;;
        *) usage; exit 2 ;;
      esac
      ;;
    action)
      shift
      local dry_run=false
      if [[ ${1:-} == --dry-run ]]; then
        dry_run=true
        shift
      fi
      [[ $# == 2 ]] || { usage; exit 2; }
      run_action "$dry_run" "$1" "$2"
      ;;
    doctor)
      shift
      run_doctor_cli "$@"
      ;;
    -h|--help|"") usage ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
